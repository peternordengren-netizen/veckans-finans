{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prices.schema.json",
  "title": "Veckans finans – kursförändringar för en vecka",
  "description": "Skrivs av scripts/prices.py till data/prices/<vecka>.json. Saknas filen, eller saknas en ticker, visar sidan aktiekortet utan kurs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week", "fetched_at", "quotes"],
  "properties": {
    "schema_version": { "const": 1 },
    "week": { "type": "string", "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "mock": { "type": "boolean" },
    "quotes": {
      "description": "Nyckel = yahoo_ticker.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_pct", "close", "currency"],
        "properties": {
          "change_pct": { "description": "Förändring i procent från föregående veckas sista stängning till veckans sista stängning.", "type": "number" },
          "close": { "type": "number" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
        }
      }
    },
    "errors": {
      "description": "yahoo_ticker -> felmeddelande för tickers som inte kunde hämtas.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
