{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swing.schema.json",
  "title": "Swing: lägesmått och beskrivande etiketter per bolag (scripts/swing.py, data/swing/<datum>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "as_of",
    "generated_at",
    "thresholds",
    "labels",
    "short_as_of",
    "companies"
  ],
  "$defs": {
    "num": {
      "type": [
        "number",
        "null"
      ]
    },
    "level": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "low",
        "high",
        "mid",
        "touches",
        "bottoms",
        "tops",
        "dist_pct",
        "dist_atr"
      ],
      "properties": {
        "kind": {
          "enum": [
            "zon",
            "20 EMA",
            "50 MA",
            "200 MA"
          ]
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "mid": {
          "type": "number"
        },
        "touches": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bottoms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tops": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dist_pct": {
          "$ref": "#/$defs/num"
        },
        "dist_atr": {
          "$ref": "#/$defs/num"
        },
        "inside": {
          "type": "boolean",
          "description": "Stängningen ligger inne i zonen (bara zoner). För motstånd räknas R då till zonens övre kant. Saknas i äldre filer."
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "Handelsdagen måtten gäller: dagsdatans datum, den senaste dagen som minst 90 % av bolagen har en kursrad för (signals.data_day)."
    },
    "expected_day": {
      "type": "string",
      "format": "date",
      "description": "Förra handelsdagen. Skiljer den sig från as_of gäller måtten en äldre dag (varning på sidan). Saknas i äldre filer."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_day", "with_expected", "of"],
      "description": "Antal bolag med kursrad för as_of respektive expected_day, av bolagen med kurser. Saknas i äldre filer.",
      "properties": {
        "with_day": {"type": "integer", "minimum": 0},
        "with_expected": {"type": "integer", "minimum": 0},
        "of": {"type": "integer", "minimum": 0}
      }
    },
    "generated_at": {
      "type": "string"
    },
    "mock": {
      "const": true
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_ratio",
        "rsi2_low",
        "rsi2_high",
        "report_days"
      ],
      "properties": {
        "volume_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rsi2_low": {
          "type": "number"
        },
        "rsi2_high": {
          "type": "number"
        },
        "report_days": {
          "type": "integer",
          "minimum": 1
        },
        "pullback": {
          "type": "object",
          "description": "Trösklar för strategin Pullback i trend (scripts/pullback.py THRESHOLDS); saknas i äldre filer.",
          "additionalProperties": false,
          "required": [
            "touch_pct",
            "hammer_shadow",
            "hammer_upper",
            "stop_days",
            "top_days",
            "trigger_days",
            "max_days"
          ],
          "properties": {
            "touch_pct": {
              "type": "number"
            },
            "hammer_shadow": {
              "type": "number"
            },
            "hammer_upper": {
              "type": "number"
            },
            "stop_days": {
              "type": "number"
            },
            "top_days": {
              "type": "number"
            },
            "trigger_days": {
              "type": "number"
            },
            "max_days": {
              "type": "number"
            },
            "fee_pct": {
              "type": "number",
              "description": "Courtage i äldre filer; räknas inte längre."
            }
          }
        },
        "levels": {
          "type": "object",
          "description": "Trösklar för stöd och motstånd (scripts/levels.py THRESHOLDS); saknas i äldre filer.",
          "additionalProperties": false,
          "required": [
            "lookback",
            "pivot",
            "merge_atr",
            "stop_buffer_atr"
          ],
          "properties": {
            "lookback": {
              "type": "number"
            },
            "pivot": {
              "type": "number"
            },
            "merge_atr": {
              "type": "number"
            },
            "stop_buffer_atr": {
              "type": "number"
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "short_as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "name",
          "sector",
          "day",
          "ma20_pct",
          "ma50_pct",
          "ma20_over_ma50",
          "rsi2",
          "rsi14",
          "atr_pct",
          "volume_ratio",
          "above_high20",
          "report_published",
          "days_since_report",
          "report_verdict",
          "short_pct",
          "labels"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sector": {
            "type": [
              "string",
              "null"
            ]
          },
          "day": {
            "type": "string"
          },
          "ma20_pct": {
            "type": "number"
          },
          "ma50_pct": {
            "type": "number"
          },
          "ma20_over_ma50": {
            "type": "boolean"
          },
          "rsi2": {
            "$ref": "#/$defs/num"
          },
          "rsi14": {
            "$ref": "#/$defs/num"
          },
          "atr_pct": {
            "$ref": "#/$defs/num"
          },
          "volume_ratio": {
            "$ref": "#/$defs/num"
          },
          "above_high20": {
            "type": "boolean"
          },
          "report_published": {
            "type": [
              "string",
              "null"
            ]
          },
          "days_since_report": {
            "type": [
              "integer",
              "null"
            ]
          },
          "report_verdict": {
            "type": [
              "string",
              "null"
            ]
          },
          "short_pct": {
            "$ref": "#/$defs/num"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "pullback": {
            "type": "object",
            "description": "Pullback i trend: tillståndet (null utan 200 handelsdagar) och nivåerna vid träff. Saknas i äldre filer.",
            "additionalProperties": false,
            "required": [
              "state",
              "levels"
            ],
            "properties": {
              "state": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "open",
                  "high",
                  "low",
                  "close",
                  "prev_open",
                  "prev_close",
                  "ema20",
                  "ma50",
                  "ma200"
                ],
                "properties": {
                  "open": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "close": {
                    "type": "number"
                  },
                  "prev_open": {
                    "type": "number"
                  },
                  "prev_close": {
                    "type": "number"
                  },
                  "ema20": {
                    "type": "number"
                  },
                  "ma50": {
                    "type": "number"
                  },
                  "ma200": {
                    "type": "number"
                  }
                }
              },
              "levels": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "level",
                  "level_value",
                  "signal",
                  "trigger",
                  "ref",
                  "stop",
                  "risk_pct",
                  "risk_atr",
                  "top",
                  "r2",
                  "r3"
                ],
                "properties": {
                  "level": {
                    "enum": [
                      "ema20",
                      "ma50"
                    ]
                  },
                  "level_value": {
                    "type": "number"
                  },
                  "signal": {
                    "enum": [
                      "hammer",
                      "engulfing",
                      null
                    ]
                  },
                  "trigger": {
                    "$ref": "#/$defs/num"
                  },
                  "ref": {
                    "type": "number"
                  },
                  "stop": {
                    "type": "number"
                  },
                  "risk_pct": {
                    "$ref": "#/$defs/num"
                  },
                  "risk_atr": {
                    "$ref": "#/$defs/num"
                  },
                  "top": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "r3": {
                    "type": "number"
                  }
                }
              },
              "bollinger": {
                "description": "Gårdagens stängning mot Bollingerbanden (20 d, 2 std) för en kandidat (scripts/bollinger.py position): %B, avståndet till övre bandet i R och om stängningen är vid eller över. Bara när levels finns; saknas i äldre filer.",
                "type": "object",
                "additionalProperties": false,
                "required": ["price", "lower", "upper", "pct_b", "upper_r", "at_upper"],
                "properties": {
                  "price": {"type": "number"},
                  "lower": {"type": "number"},
                  "upper": {"type": "number"},
                  "pct_b": {"$ref": "#/$defs/num"},
                  "upper_r": {"$ref": "#/$defs/num"},
                  "at_upper": {"type": "boolean"}
                }
              }
            }
          },
          "bb_upper_pct": {
            "$ref": "#/$defs/num",
            "description": "Stängningen mot övre Bollingerbandet i procent (saknas i äldre filer)."
          },
          "sr": {
            "type": [
              "object",
              "null"
            ],
            "description": "Stöd och motstånd (scripts/levels.py): närmaste stöd och motstånd, triggernivå, stopp under stödet och motstånd i R; null utan ATR. Saknas i äldre filer.",
            "additionalProperties": false,
            "required": [
              "support",
              "resistance",
              "trigger",
              "stop",
              "resistance_r"
            ],
            "properties": {
              "support": {
                "$ref": "#/$defs/level"
              },
              "resistance": {
                "$ref": "#/$defs/level"
              },
              "trigger": {
                "type": "number"
              },
              "stop": {
                "$ref": "#/$defs/num"
              },
              "resistance_r": {
                "$ref": "#/$defs/num"
              }
            }
          },
          "ma_cross": {
            "enum": [
              "golden",
              "death",
              null
            ],
            "description": "Senaste korsningen mellan 50 och 200 dagars MA de senaste 10 handelsdagarna (saknas i äldre filer)."
          },
          "ma_cross_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Handelsdagar sedan korsningen, 0 = gårdagen (saknas i äldre filer)."
          }
        }
      }
    },
    "strategies": {
      "type": "object",
      "description": "Strategier i rullistan: namn och etiketterna som räknas som träff. Saknas i äldre filer.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "labels"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
