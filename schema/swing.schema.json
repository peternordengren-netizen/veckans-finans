{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swing.schema.json",
  "title": "Swing: lägesmått och beskrivande etiketter per bolag (scripts/swing.py, data/swing/<datum>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "as_of",
    "generated_at",
    "thresholds",
    "labels",
    "short_as_of",
    "companies"
  ],
  "$defs": {
    "num": {
      "type": [
        "number",
        "null"
      ]
    },
    "level": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "low",
        "high",
        "mid",
        "touches",
        "bottoms",
        "tops",
        "dist_pct",
        "dist_atr"
      ],
      "properties": {
        "kind": {
          "enum": [
            "zon",
            "20 EMA",
            "50 MA",
            "200 MA"
          ]
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "mid": {
          "type": "number"
        },
        "touches": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bottoms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tops": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dist_pct": {
          "$ref": "#/$defs/num"
        },
        "dist_atr": {
          "$ref": "#/$defs/num"
        },
        "inside": {
          "type": "boolean",
          "description": "Stängningen ligger inne i zonen (bara zoner). För motstånd räknas R då till zonens övre kant. Saknas i äldre filer."
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "Handelsdagen måtten gäller: dagsdatans datum, den senaste dagen som minst 90 % av bolagen har en kursrad för (signals.data_day)."
    },
    "expected_day": {
      "type": "string",
      "format": "date",
      "description": "Förra handelsdagen. Skiljer den sig från as_of gäller måtten en äldre dag (varning på sidan). Saknas i äldre filer."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_day", "with_expected", "of"],
      "description": "Antal bolag med kursrad för as_of respektive expected_day, av bolagen med kurser. Saknas i äldre filer.",
      "properties": {
        "with_day": {"type": "integer", "minimum": 0},
        "with_expected": {"type": "integer", "minimum": 0},
        "of": {"type": "integer", "minimum": 0}
      }
    },
    "generated_at": {
      "type": "string"
    },
    "mock": {
      "const": true
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_ratio",
        "rsi2_low",
        "rsi2_high",
        "report_days"
      ],
      "properties": {
        "volume_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rsi2_low": {
          "type": "number"
        },
        "rsi2_high": {
          "type": "number"
        },
        "report_days": {
          "type": "integer",
          "minimum": 1
        },
        "pullback": {
          "type": "object",
          "description": "Trösklar för strategin Pullback i trend (scripts/pullback.py THRESHOLDS); saknas i äldre filer.",
          "additionalProperties": false,
          "required": [
            "touch_pct",
            "hammer_shadow",
            "hammer_upper",
            "stop_days",
            "top_days",
            "trigger_days",
            "max_days"
          ],
          "properties": {
            "touch_pct": {
              "type": "number"
            },
            "hammer_shadow": {
              "type": "number"
            },
            "hammer_upper": {
              "type": "number"
            },
            "stop_days": {
              "type": "number"
            },
            "top_days": {
              "type": "number"
            },
            "trigger_days": {
              "type": "number"
            },
            "max_days": {
              "type": "number"
            },
            "fee_pct": {
              "type": "number",
              "description": "Courtage i äldre filer; räknas inte längre."
            }
          }
        },
        "levels": {
          "type": "object",
          "description": "Trösklar för stöd och motstånd (scripts/levels.py THRESHOLDS); saknas i äldre filer.",
          "additionalProperties": false,
          "required": [
            "lookback",
            "pivot",
            "merge_atr",
            "stop_buffer_atr"
          ],
          "properties": {
            "lookback": {
              "type": "number"
            },
            "pivot": {
              "type": "number"
            },
            "merge_atr": {
              "type": "number"
            },
            "stop_buffer_atr": {
              "type": "number"
            }
          }
        },
        "ranking": {
          "type": "object",
          "description": "Trösklar för rangordningen av Pullback-kandidaterna (scripts/ranking.py THRESHOLDS); saknas i äldre filer.",
          "additionalProperties": false,
          "required": ["resistance_r", "support_atr", "bollinger_r", "stop_atr", "ma50_days", "top"],
          "properties": {
            "resistance_r": {"type": "number"},
            "support_atr": {"type": "number"},
            "bollinger_r": {"type": "number"},
            "stop_atr": {"type": "number"},
            "ma50_days": {"type": "integer"},
            "top": {"type": "integer"}
          }
        },
        "bbrekyl": {
          "type": "object",
          "description": "Trösklar för Rekyl efter Bollingerutbrott (scripts/bbrekyl.py THRESHOLDS och RANK_THRESHOLDS); saknas i äldre filer.",
          "additionalProperties": false,
          "required": ["breakout_days", "volume_ratio", "touch_pct", "bb_period", "bb_width", "volume_days", "ranking"],
          "properties": {
            "breakout_days": {"type": "integer"},
            "volume_ratio": {"type": "number"},
            "base_volume_ratio": {"type": "number"},
            "red_volume_ratio": {"type": "number"},
            "required_rules": {"type": "array", "items": {"enum": ["r1", "r2", "r3", "r4"]}},
            "touch_pct": {"type": "number"},
            "bb_period": {"type": "integer"},
            "bb_width": {"type": "number"},
            "volume_days": {"type": "integer"},
            "ranking": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_r", "bollinger_r", "stop_atr", "ma50_days", "top"],
              "properties": {
                "target_r": {"type": "number"},
                "bollinger_r": {"type": "number"},
                "stop_atr": {"type": "number"},
                "ma50_days": {"type": "integer"},
                "top": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "bbrekyl_criteria": {
      "type": "object",
      "description": "Rangkriterierna för Rekyl efter Bollingerutbrott (scripts/bbrekyl.py CRITERIA); saknas i äldre filer.",
      "additionalProperties": {"type": "string"}
    },
    "ranking_criteria": {
      "type": "object",
      "description": "Rangordningens kriterier: nyckel och text (scripts/ranking.py CRITERIA); saknas i äldre filer.",
      "additionalProperties": {"type": "string"}
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "short_as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing": {
      "type": "array",
      "description": "Noterade bolag som saknas i tabellen: Yahoo saknar kursdata (no_data) eller för kort historik (short_history, bars = antal dagar). Saknas i äldre filer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "reason", "bars"],
        "properties": {
          "ticker": {"type": "string"},
          "name": {"type": "string"},
          "reason": {"enum": ["no_data", "short_history"]},
          "bars": {"type": "integer", "minimum": 0}
        }
      }
    },
    "delisted": {
      "type": "array",
      "description": "Avnoterade bolag (instruments.csv): sista handelsdag och källa. Hoppas över i beräkningarna. Saknas i äldre filer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "last_day", "source"],
        "properties": {
          "ticker": {"type": "string"},
          "name": {"type": "string"},
          "last_day": {"type": "string", "format": "date"},
          "source": {"type": "string"}
        }
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "name",
          "sector",
          "day",
          "ma20_pct",
          "ma50_pct",
          "ma20_over_ma50",
          "rsi2",
          "rsi14",
          "atr_pct",
          "volume_ratio",
          "above_high20",
          "report_published",
          "days_since_report",
          "report_verdict",
          "short_pct",
          "labels"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sector": {
            "type": [
              "string",
              "null"
            ]
          },
          "day": {
            "type": "string"
          },
          "ma20_pct": {
            "type": "number"
          },
          "ma50_pct": {
            "type": "number"
          },
          "ma20_over_ma50": {
            "type": "boolean"
          },
          "rsi2": {
            "$ref": "#/$defs/num"
          },
          "rsi14": {
            "$ref": "#/$defs/num"
          },
          "atr_pct": {
            "$ref": "#/$defs/num"
          },
          "volume_ratio": {
            "$ref": "#/$defs/num"
          },
          "above_high20": {
            "type": "boolean"
          },
          "report_published": {
            "type": [
              "string",
              "null"
            ]
          },
          "days_since_report": {
            "type": [
              "integer",
              "null"
            ]
          },
          "report_verdict": {
            "type": [
              "string",
              "null"
            ]
          },
          "short_pct": {
            "$ref": "#/$defs/num"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "pullback": {
            "type": "object",
            "description": "Pullback i trend: tillståndet (null utan 200 handelsdagar) och nivåerna vid träff. Saknas i äldre filer.",
            "additionalProperties": false,
            "required": [
              "state",
              "levels"
            ],
            "properties": {
              "state": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "open",
                  "high",
                  "low",
                  "close",
                  "prev_open",
                  "prev_close",
                  "ema20",
                  "ma50",
                  "ma200"
                ],
                "properties": {
                  "open": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "close": {
                    "type": "number"
                  },
                  "prev_open": {
                    "type": "number"
                  },
                  "prev_close": {
                    "type": "number"
                  },
                  "ema20": {
                    "type": "number"
                  },
                  "ma50": {
                    "type": "number"
                  },
                  "ma200": {
                    "type": "number"
                  }
                }
              },
              "levels": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "level",
                  "level_value",
                  "signal",
                  "trigger",
                  "ref",
                  "stop",
                  "risk_pct",
                  "risk_atr",
                  "top",
                  "r2",
                  "r3"
                ],
                "properties": {
                  "level": {
                    "enum": [
                      "ema20",
                      "ma50"
                    ]
                  },
                  "level_value": {
                    "type": "number"
                  },
                  "signal": {
                    "enum": [
                      "hammer",
                      "engulfing",
                      null
                    ]
                  },
                  "trigger": {
                    "$ref": "#/$defs/num"
                  },
                  "ref": {
                    "type": "number"
                  },
                  "stop": {
                    "type": "number"
                  },
                  "risk_pct": {
                    "$ref": "#/$defs/num"
                  },
                  "risk_atr": {
                    "$ref": "#/$defs/num"
                  },
                  "top": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "r3": {
                    "type": "number"
                  }
                }
              },
              "rank": {
                "description": "Rangordningen bland kandidaterna (scripts/ranking.py): rang 1..n, poäng = antal uppfyllda kriterier, kriterierna och mätvärdena de prövas mot. Bara när levels finns; saknas i äldre filer.",
                "type": "object",
                "additionalProperties": false,
                "required": ["rank", "score", "criteria", "measures"],
                "properties": {
                  "rank": {"type": "integer", "minimum": 1},
                  "score": {"type": "integer", "minimum": 0},
                  "criteria": {"type": "object", "additionalProperties": {"type": "boolean"}},
                  "measures": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["signal", "room_r", "has_resistance", "support_atr", "upper_r", "stop_atr", "ma50_change_pct"],
                    "properties": {
                      "signal": {"type": "boolean"},
                      "room_r": {"$ref": "#/$defs/num"},
                      "has_resistance": {"type": "boolean"},
                      "support_atr": {"$ref": "#/$defs/num"},
                      "upper_r": {"$ref": "#/$defs/num"},
                      "stop_atr": {"$ref": "#/$defs/num"},
                      "ma50_change_pct": {"$ref": "#/$defs/num"}
                    }
                  }
                }
              },
              "bollinger": {
                "description": "Gårdagens stängning mot Bollingerbanden (20 d, 2 std) för en kandidat (scripts/bollinger.py position): %B, avståndet till övre bandet i R och om stängningen är vid eller över. Bara när levels finns; saknas i äldre filer.",
                "type": "object",
                "additionalProperties": false,
                "required": ["price", "lower", "upper", "pct_b", "upper_r", "at_upper"],
                "properties": {
                  "price": {"type": "number"},
                  "lower": {"type": "number"},
                  "upper": {"type": "number"},
                  "pct_b": {"$ref": "#/$defs/num"},
                  "upper_r": {"$ref": "#/$defs/num"},
                  "at_upper": {"type": "boolean"}
                }
              }
            }
          },
          "bbrekyl": {
            "type": "object",
            "description": "Rekyl efter Bollingerutbrott (scripts/bbrekyl.py): fönstret (null utan 70 handelsdagar), och vid träff nivåerna, Bollingerläget och rangen. Saknas i äldre filer.",
            "additionalProperties": false,
            "required": ["state", "levels"],
            "properties": {
              "state": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["days", "ema20"],
                "properties": {
                  "ema20": {"type": "number"},
                  "days": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["open", "high", "low", "close", "volume", "volume_avg", "mid", "upper", "ma50"],
                      "properties": {
                        "open": {"type": "number"},
                        "high": {"type": "number"},
                        "low": {"type": "number"},
                        "close": {"type": "number"},
                        "volume": {"type": "number"},
                        "volume_avg": {"type": "number"},
                        "mid": {"type": "number"},
                        "upper": {"type": "number"},
                        "ma50": {"type": "number"}
                      }
                    }
                  }
                }
              },
              "levels": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["level", "signal", "trigger", "ref", "stop", "risk_pct", "risk_atr", "target", "target_r",
                             "r2", "r3", "breakout", "lower_volume"],
                "properties": {
                  "level": {"enum": ["mid", "ema20", "mellan"]},
                  "signal": {"enum": ["hammer", "engulfing", null]},
                  "trigger": {"$ref": "#/$defs/num"},
                  "ref": {"type": "number"},
                  "stop": {"type": "number"},
                  "risk_pct": {"$ref": "#/$defs/num"},
                  "risk_atr": {"$ref": "#/$defs/num"},
                  "target": {"type": "number"},
                  "target_r": {"type": "number"},
                  "r2": {"type": "number"},
                  "r3": {"type": "number"},
                  "lower_volume": {"type": "boolean"},
                  "volume": {
                    "type": "object",
                    "description": "Volymvillkoren r1–r4 med siffrorna (scripts/bbrekyl.volume_checks); saknas i äldre filer.",
                    "additionalProperties": false,
                    "required": ["breakout_ratio", "r1", "red_days", "red_max_ratio", "r2", "rekyl_avg_ratio", "r3",
                                 "up_volume", "down_volume", "r4"],
                    "properties": {
                      "breakout_ratio": {"type": "number"},
                      "r1": {"type": "boolean"},
                      "red_days": {"type": "integer", "minimum": 0},
                      "red_max_ratio": {"$ref": "#/$defs/num"},
                      "r2": {"type": "boolean"},
                      "rekyl_avg_ratio": {"$ref": "#/$defs/num"},
                      "r3": {"type": "boolean"},
                      "up_volume": {"type": "number"},
                      "down_volume": {"type": "number"},
                      "r4": {"type": "boolean"}
                    }
                  },
                  "breakout": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["day", "days_ago", "close", "upper", "low", "volume_ratio", "report"],
                    "properties": {
                      "day": {"type": "string", "format": "date"},
                      "days_ago": {"type": "integer", "minimum": 1},
                      "close": {"type": "number"},
                      "upper": {"type": "number"},
                      "low": {"type": "number"},
                      "volume_ratio": {"type": "number"},
                      "report": {
                        "type": ["object", "null"],
                        "description": "Utbrottsdagen var reaktionsdag för en rapport: publiceringstid och utfallet mot förväntan för vinst per aktie (null = okänt).",
                        "additionalProperties": false,
                        "required": ["published", "verdict"],
                        "properties": {
                          "published": {"type": "string"},
                          "verdict": {"type": ["string", "null"]}
                        }
                      }
                    }
                  }
                }
              },
              "rank": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rank", "score", "criteria", "measures"],
                "properties": {
                  "rank": {"type": "integer", "minimum": 1},
                  "score": {"type": "integer", "minimum": 0},
                  "criteria": {"type": "object", "additionalProperties": {"type": "boolean"}},
                  "measures": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["signal", "room_r", "has_resistance", "upper_r", "stop_atr", "ma50_change_pct"],
                    "properties": {
                      "signal": {"type": "boolean"},
                      "lower_volume": {"type": "boolean", "description": "Bara i äldre filer (rangkriterium till 2026-11-10)."},
                      "r1": {"type": "boolean"},
                      "r3": {"type": "boolean"},
                      "r4": {"type": "boolean"},
                      "room_r": {"$ref": "#/$defs/num"},
                      "has_resistance": {"type": "boolean"},
                      "upper_r": {"$ref": "#/$defs/num"},
                      "stop_atr": {"$ref": "#/$defs/num"},
                      "ma50_change_pct": {"$ref": "#/$defs/num"}
                    }
                  }
                }
              },
              "bollinger": {
                "type": "object",
                "additionalProperties": false,
                "required": ["price", "lower", "upper", "pct_b", "upper_r", "at_upper"],
                "properties": {
                  "price": {"type": "number"},
                  "lower": {"type": "number"},
                  "upper": {"type": "number"},
                  "pct_b": {"$ref": "#/$defs/num"},
                  "upper_r": {"$ref": "#/$defs/num"},
                  "at_upper": {"type": "boolean"}
                }
              }
            }
          },
          "bb_upper_pct": {
            "$ref": "#/$defs/num",
            "description": "Stängningen mot övre Bollingerbandet i procent (saknas i äldre filer)."
          },
          "sr": {
            "type": [
              "object",
              "null"
            ],
            "description": "Stöd och motstånd (scripts/levels.py): närmaste stöd och motstånd, triggernivå och stopp under stödet (en alternativ stoppnivå); null utan ATR. Saknas i äldre filer.",
            "additionalProperties": false,
            "required": [
              "support",
              "resistance",
              "trigger",
              "stop"
            ],
            "properties": {
              "support": {
                "$ref": "#/$defs/level"
              },
              "resistance": {
                "$ref": "#/$defs/level"
              },
              "trigger": {
                "type": "number"
              },
              "stop": {
                "$ref": "#/$defs/num"
              },
              "resistance_r": {
                "$ref": "#/$defs/num",
                "description": "Bara i äldre filer: motståndet i R räknat på stoppet under stödet. Nya filer har ett enda R, strategins (pullback.rank.measures.room_r)."
              }
            }
          },
          "ma_cross": {
            "enum": [
              "golden",
              "death",
              null
            ],
            "description": "Senaste korsningen mellan 50 och 200 dagars MA de senaste 10 handelsdagarna (saknas i äldre filer)."
          },
          "ma_cross_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Handelsdagar sedan korsningen, 0 = gårdagen (saknas i äldre filer)."
          }
        }
      }
    },
    "strategies": {
      "type": "object",
      "description": "Strategier i rullistan: namn och etiketterna som räknas som träff. Saknas i äldre filer.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "labels"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
