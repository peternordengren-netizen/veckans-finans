---
/**
 * Startsidan: senaste Bollingerkontrollen under dagen överst, därefter eftermiddagsuppdateringen (om den är minst lika ny som morgonrapporten),
 * därefter senaste morgonrapporten (dagens, eller den senaste med datum),
 * därefter senaste veckan med flikarna. Tomt läge innan något publicerats.
 */
import Base from "../layouts/Base.astro";
import WeekPage from "../components/WeekPage.astro";
import { listMorningDates, listWeeks, loadLatestAfternoon, loadLatestBollinger, loadMorning, loadWeek } from "../lib/data";

const weeks = listWeeks();
const view = weeks.length > 0 ? loadWeek(weeks[0]) : null;
const mornings = listMorningDates();
const morning = mornings.length > 0 ? loadMorning(mornings[0]) : null;
// Eftermiddagen visas bara så länge den inte är äldre än morgonrapporten (nästa morgon tar över).
const latestAfternoon = loadLatestAfternoon();
const afternoon = latestAfternoon && latestAfternoon.date >= (morning?.date ?? "") ? latestAfternoon : null;
// Senaste Bollingerkontrollen under dagen, överst (med datum och tid).
const bollinger = loadLatestBollinger();
---

{
  view ? (
    <WeekPage view={view} weeks={weeks} morning={morning} afternoon={afternoon} bollinger={bollinger} />
  ) : (
    <Base title="Veckans finans">
      <main class="wrap empty-state">
        <h1>Veckans finans</h1>
        <p>Ingen vecka är publicerad ännu.</p>
      </main>
    </Base>
  )
}

<style>
  .empty-state {
    padding-top: 48px;
  }
</style>
