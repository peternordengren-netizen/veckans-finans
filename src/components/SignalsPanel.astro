---
/**
 * Signalöversikt per bolag i en sorterbar tabell. Filtret har tre lägen: "Alla", "Med signal" och
 * "Starka signaler" (förvalt, src/lib/signals.isStrong); utan JavaScript visas alla bolag i filens ordning.
 */
import type { SignalsView } from "../lib/data";
import { dayMonth, defaultOrder, isStrong, ratio, sek, shortChange, signalChip, signedPct } from "../lib/signals";

interface Props {
  signals: SignalsView;
  /** Bolag som rapporterat under veckan (rapportutfallen): deras stora kursrörelse räknas inte som stark. */
  reported?: string[];
}
const { signals, reported = [] } = Astro.props;
const reportedSet = new Set(reported);
// Förvald sortering: kolumnen "Antal", flest först (se DEFAULT_SORT nedan).
const rows = defaultOrder(signals.rows);
const flagged = rows.filter((r) => r.signals.length > 0).length;
const strong = rows.filter((r) => isStrong(r.signals, reportedSet.has(r.ticker))).length;
const t = signals.thresholds;
// Blankning finns bara i äldre veckor (till 2026-11-11, med blankningströskeln i filen): då visas kolumnen och
// signalen som de var. Den räknas inte i "Starka signaler".
const hasShort = t.short_aggregate_pp !== undefined;
const n = (v: number) => new Intl.NumberFormat("sv-SE", { maximumFractionDigits: 2 }).format(v);
const toneOrder = { positiv: 3, blandad: 2, neutral: 1, negativ: 0 };

// Kolumner: nyckel för sortering och om värdet är tal eller text.
const columns = [
  { key: "name", label: "Bolag", type: "text" },
  { key: "count", label: "Antal", type: "num", title: "Antal signaler" },
  { key: "signals", label: "Signaler", type: "text" },
  { key: "tone", label: "Ton", type: "num" },
  { key: "change", label: "Vecka", type: "num" },
  { key: "relative", label: "Mot index", type: "num" },
  { key: "volume", label: "Omsättning", type: "num" },
  { key: "high", label: "Från 52 v högsta", type: "num" },
  { key: "low", label: "Från 52 v lägsta", type: "num" },
  { key: "insider", label: "Insyn netto", type: "num" },
  ...(hasShort ? [{ key: "short", label: "Blankning", type: "num" }] : []),
] as { key: string; label: string; type: string; title?: string }[];
const v = (x: number | null) => (x === null ? "" : String(x));
const DEFAULT_SORT = "count";
---

<div class="signals" data-signals>
  <p class="lead">
    Alla {rows.length} bolag i bevakningslistan, med veckans kurs, omsättning och 52-veckorsläge samt nyhetston och
    insyn{hasShort && " (den här veckan också blankning)"}. Klicka på en kolumnrubrik för att sortera.
  </p>
  {
    hasShort && signals.shortUntil && (
      <p class="warn-box">
        Blankningen bygger bara på FI:s register t.o.m. {dayMonth(signals.shortUntil)}, inte hela veckan: FI tillåter inte
        längre skriptad hämtning, och nyare filer har inte laddats ner (se morgonrapporten). Blankningssignalerna märks
        "t.o.m. {dayMonth(signals.shortUntil)}".
      </p>
    )
  }
  <details class="legend">
    <summary>Så räknas signalerna</summary>
    <ul>
      <li>
        <strong>Insynsköp / Insynsförsäljning:</strong> insynspersoner har köpt eller sålt för mer än 100 000 kr under
        veckan; etiketten följer nettot (står det bara "Insyn" tar köp och försäljningar ut varandra).
      </li>
      {
        hasShort && t.short_aggregate_pp !== undefined && (
          <li>
            <strong>Blankning</strong> (bara äldre veckor, räknas inte sedan 2026-11-11):{" "}
            {t.short_only_aggregate
              ? `den sammanlagda blankningen har ändrats med minst ${n(t.short_aggregate_pp)} procentenheter.`
              : `en enskild position över 0,5 % har ändrats, eller den sammanlagda blankningen har ändrats med minst ${n(t.short_aggregate_pp)} procentenheter.`}
          </li>
        )
      }
      <li><strong>Avviker mot index:</strong> nyhetens ton och kursen mot index går åt olika håll.</li>
      <li>
        <strong>Stor rörelse mot index:</strong> veckans kurs skiljer sig mer än ±{n(t.big_move_pp)} % från index, oavsett
        om det finns någon nyhet.
      </li>
      <li>
        <strong>Hög omsättning:</strong> veckans snittomsättning är minst {n(t.volume_ratio)} gånger snittet för de 20
        handelsdagarna före.
      </li>
      <li>
        <strong>P/E +30 % i år:</strong> P/E har stigit minst {n(t.pe_up_pct)} % sedan årets början, alltså kursen har dragit
        ifrån vinsten (se fliken Kurs mot vinst).
      </li>
      <li>
        <strong>Nära 52 v högsta/lägsta:</strong> fredagens stängning ligger högst {n(t.near_52w_pct)} % från årets högsta
        eller lägsta kurs.
      </li>
    </ul>
    <p>
      <strong>Starka signaler</strong> (förvalt): minst två signaler, eller minst en av insyn, avviker mot index, nära
      52 v högsta/lägsta och P/E +30 % i år. Blankning räknas inte, inte heller i äldre veckor där den finns kvar. För ett bolag som rapporterat under veckan räknas en stor
      rörelse mot index inte – det är rapportreaktionen, som visas under Rapporterade bolag.
    </p>
    <p>Signalerna är mekaniska och säger inget om varför något hänt. De är inga köp- eller säljsignaler.</p>
  </details>

  <div class="controls">
    <fieldset class="filter" data-filter>
      <legend class="sr-only">Visa</legend>
      <label><input type="radio" name="signal-filter" value="all" /> Alla ({rows.length})</label>
      <label><input type="radio" name="signal-filter" value="flagged" /> Med signal ({flagged})</label>
      <label><input type="radio" name="signal-filter" value="strong" checked /> Starka signaler ({strong})</label>
    </fieldset>
    <span class="shown" data-shown aria-live="polite">{strong} av {rows.length} bolag har starka signaler</span>
  </div>

  <div class="table-outer" data-table-outer>
  <div class="table-wrap" data-table-wrap>
    <table>
      <thead>
        <tr>
          {
            columns.map((c) => (
              <th
                scope="col"
                class={`col-${c.key}`}
                data-key={c.key}
                data-type={c.type}
                aria-sort={c.key === DEFAULT_SORT ? "descending" : "none"}
              >
                <button type="button" title={"title" in c ? c.title : undefined}>{c.label}</button>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => {
            const s = shortChange(r);
            const chips = r.signals.map((sig) => signalChip(sig, r, signals.shortUntil));
            return (
              <tr
                data-flagged={r.signals.length > 0 ? "1" : "0"}
                data-strong={isStrong(r.signals, reportedSet.has(r.ticker)) ? "1" : "0"}
              >
                <th scope="row" data-v={r.name}>
                  <span class="name">{r.name}</span> <span class="ticker">{r.ticker}</span>
                </th>
                <td class="num col-count" data-v={r.signals.length}>
                  {r.signals.length}
                </td>
                <td class="col-signals" data-v={chips.map((c) => c.label).join(", ")}>
                  <span class="chips">
                    {chips.map((c) => (
                      <span class:list={["chip", c.cls]}>{c.label}</span>
                    ))}
                  </span>
                </td>
                <td data-v={r.tone === null ? "" : toneOrder[r.tone]}>
                  {r.tone ? <span class:list={["tone", r.tone]}>{r.tone}</span> : <span class="none">–</span>}
                </td>
                <td class="num" data-v={v(r.change_pct)}>{signedPct(r.change_pct)}</td>
                <td class:list={["num", r.relative_pp !== null && (r.relative_pp > 0 ? "pos" : r.relative_pp < 0 ? "neg" : "")]} data-v={v(r.relative_pp)}>
                  {signedPct(r.relative_pp)}
                </td>
                <td class="num" data-v={v(r.volume_ratio)}>{ratio(r.volume_ratio)}</td>
                <td class="num" data-v={v(r.from_high_pct)}>{signedPct(r.from_high_pct)}</td>
                <td class="num" data-v={v(r.from_low_pct)}>{signedPct(r.from_low_pct)}</td>
                <td
                  class="num"
                  data-v={v(r.insider_net_sek)}
                  title={r.insider_net_sek !== null ? `${r.insider_buyers} köpare, ${r.insider_sellers} säljare` : undefined}
                >
                  {sek(r.insider_net_sek)}
                </td>
                {hasShort && (
                  <td
                    class="num"
                    data-v={v(s)}
                    title={[r.short_positions_pp != null ? "enskilda positioner över 0,5 %" : s !== null ? "sammanlagd blankning" : null,
                      s !== null && signals.shortUntil ? `t.o.m. ${dayMonth(signals.shortUntil)}` : null].filter(Boolean).join(", ") || undefined}
                  >
                    {signedPct(s, 2)}
                  </td>
                )}
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  </div>
  <p class="note">
    "Mot index" jämför med OMX Stockholm PI och visas bara för aktier i kronor.{hasShort && " Blankning visar förändringen i andel av aktierna."}
  </p>
</div>

<script>
  import { setupFullWidth, setupSortable, setupStickyHeader } from "../lib/tableClient";

  for (const root of document.querySelectorAll<HTMLElement>("[data-signals]")) {
    const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>("tbody tr"));
    const filter = root.querySelector<HTMLElement>("[data-filter]")!;
    const shown = root.querySelector<HTMLElement>("[data-shown]")!;
    const count = (attr: "flagged" | "strong") => rows.filter((r) => r.dataset[attr] === "1").length;
    const flagged = count("flagged");
    const strong = count("strong");

    const applyFilter = () => {
      const mode = filter.querySelector<HTMLInputElement>("input:checked")?.value ?? "strong";
      for (const r of rows) {
        r.hidden = mode === "flagged" ? r.dataset.flagged !== "1" : mode === "strong" ? r.dataset.strong !== "1" : false;
      }
      shown.textContent =
        mode === "strong"
          ? `Visar ${strong} bolag med starka signaler av ${rows.length}`
          : mode === "flagged"
            ? `Visar ${flagged} bolag med signal av ${rows.length}`
            : `Visar alla ${rows.length} bolag, varav ${flagged} med signal och ${strong} med starka signaler`;
    };
    filter.addEventListener("change", applyFilter);
    applyFilter();
    setupFullWidth(root);
    setupSortable(root);
    setupStickyHeader(root);
  }
</script>

<style>
  .lead {
    margin: 0 0 8px;
    max-width: 70ch;
  }
  .legend {
    margin: 0 0 12px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .legend summary {
    cursor: pointer;
    color: var(--accent);
  }
  .legend ul {
    margin: 6px 0;
    padding-left: 18px;
  }
  .legend p {
    margin: 0;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-items: center;
    margin-bottom: 8px;
    font-size: 0.9375rem;
  }
  .controls label {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    cursor: pointer;
  }
  .shown {
    color: var(--muted);
    font-size: 0.875rem;
  }
  /* Filtret: tre lägen i en rad (Alla, Med signal, Starka signaler). */
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* Tabellen bryter ut ur textspalten och använder fönstrets bredd (16 px marginal per sida).
     --sbw = rullningslistens bredd, sätts av skriptet. */
  .table-outer {
    --full: calc(100vw - var(--sbw, 0px) - 32px);
    position: relative;
    /* Egen staplingskontext: den fasta kolumnen och skuggan får inte hamna över flikraden. */
    isolation: isolate;
    width: var(--full);
    margin-left: calc((100% - var(--full)) / 2);
  }
  .table-outer::after {
    content: "";
    position: absolute;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: 32px;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: linear-gradient(to left, var(--scroll-shadow), transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    z-index: 3;
  }
  .table-outer.more-right::after {
    opacity: 1;
  }
  /* Rullat åt höger: skugga vid kanten av den fasta bolagskolumnen. */
  .table-outer.more-left :is(tbody th, thead th:first-child) {
    box-shadow: 8px 0 8px -6px var(--scroll-shadow);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 6px 10px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    vertical-align: top;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    position: sticky;
    top: 0;
    background: var(--surface-2);
    padding: 0;
  }
  thead button {
    font: inherit;
    font-weight: 600;
    color: var(--text);
    background: none;
    border: 0;
    padding: 8px 10px;
    cursor: pointer;
    width: 100%;
    text-align: left;
    /* Långa rubriker ("Från 52 v högsta") får bryta så att kolumnerna blir smalare. */
    white-space: normal;
    min-width: 4.5rem;
  }
  thead th.col-name button {
    min-width: 0;
  }
  thead th:first-child {
    left: 0;
    z-index: 2;
  }
  .col-count {
    width: 1%;
    text-align: right;
  }
  thead .col-count button {
    text-align: right;
  }
  thead th[aria-sort="ascending"] button::after {
    content: " ▲";
  }
  thead th[aria-sort="descending"] button::after {
    content: " ▼";
  }
  tbody th {
    font-weight: normal;
    position: sticky;
    left: 0;
    background: var(--surface);
    /* Långa bolagsnamn bryts hellre än att bolagskolumnen tar halva bredden. */
    white-space: normal;
    min-width: 9rem;
    max-width: 13rem;
  }
  .name {
    font-weight: 600;
  }
  .ticker,
  .none {
    color: var(--muted);
  }
  .ticker {
    font-size: 0.75rem;
  }
  .num {
    text-align: right;
  }
  .pos {
    color: var(--pos);
  }
  .neg {
    color: var(--neg);
  }
  /* Etiketterna ligger bredvid varandra och radbryts bara när cellen blir för smal. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    min-width: 15rem;
    max-width: 22rem;
    white-space: normal;
  }
  .chip {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
    padding: 0 5px;
    border-radius: 3px;
    white-space: nowrap;
    background: var(--direct-bg);
    color: var(--direct-fg);
  }
  .chip.avviker,
  .chip.stor-rörelse,
  .chip.pe-upp,
  .chip.blankning {
    background: var(--banner-bg);
    color: var(--banner-fg);
  }
  .chip.insyn {
    background: var(--indirect-bg);
    color: var(--indirect-fg);
  }
  .chip.insyn-kop {
    background: var(--pos-bg);
    color: var(--pos);
  }
  .chip.insyn-salj {
    background: var(--neg-bg);
    color: var(--neg);
  }
  .tone {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 4px;
    border: 1px solid currentColor;
    color: var(--muted);
  }
  .tone.positiv {
    color: var(--pos);
  }
  .tone.negativ {
    color: var(--neg);
  }
  tr[hidden] {
    display: none;
  }
  .note {
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
