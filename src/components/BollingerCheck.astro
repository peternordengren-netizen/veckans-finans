---
/**
 * Senaste Bollingerkontrollen under handelsdagen (scripts/bollinger.py, vardagar 09:20 och 13:20): bolag vid eller
 * över det övre bandet och, separat, inom 1 % under det. Överst på startsidan. Ett informationsverktyg: listan
 * beskriver var kursen ligger mot bandet och är ingen uppmaning.
 */
import type { BollingerCheck, BollingerRow } from "../lib/data";
import { signedPct } from "../lib/signals";

interface Props {
  check: BollingerCheck;
}
const { check } = Astro.props;
const t = check.thresholds;
const price = (v: number) => v.toLocaleString("sv-SE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const groups: { title: string; rows: BollingerRow[] }[] = [
  { title: "Vid eller över övre bandet", rows: check.over },
  { title: `Inom ${t.near_pct.toLocaleString("sv-SE")} % under övre bandet`, rows: check.near },
];
---

<div class="bollinger">
  <p class="note">
    Övre Bollingerbandet: snittet av de {t.period} senaste stängningskurserna plus {t.width.toLocaleString("sv-SE")}
    {" "}standardavvikelser, med den aktuella kursen som den {t.period}:e. {check.delay_note} {check.checked} bolag
    kontrollerade{check.missing > 0 ? `, ${check.missing} utan kurs i dag` : ""}. Listan beskriver var kursen ligger mot
    bandet, inget annat.
  </p>
  <div class="groups">
    {
      groups.map((g) => (
        <section class="group">
          <h3>
            {g.title} <span class="n">({g.rows.length})</span>
          </h3>
          {g.rows.length === 0 ? (
            <p class="empty">Inga bolag.</p>
          ) : (
            <ul>
              {g.rows.map((r) => (
                <li>
                  <span class="name">{r.name}</span> <span class="muted">{r.ticker}</span>{" "}
                  <span class="num">{price(r.price)}</span>{" "}
                  <span class="muted">
                    (band {price(r.upper)}, {signedPct(r.vs_upper_pct)})
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</div>

<style>
  .note,
  .muted,
  .empty {
    color: var(--muted);
  }
  .note {
    margin: 6px 0 10px;
    font-size: 0.875rem;
    max-width: 80ch;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 12px 24px;
  }
  .group h3 {
    margin: 0 0 4px;
    font-size: 1rem;
  }
  .group .n {
    color: var(--muted);
    font-weight: normal;
  }
  ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: 0.9375rem;
  }
  .name {
    font-weight: 600;
  }
  .num {
    font-variant-numeric: tabular-nums;
  }
  .empty {
    margin: 0;
  }
</style>
