---
/**
 * Eftermiddagsuppdateringen överst på startsidan (scripts/afternoon.py och rapportutfallen från
 * dagens uppdateringar): dagens kursreaktion för bolagen som rapporterat, och utfallen i rapporterna
 * som kommit sedan morgonrapporten.
 */
import { loadReactionOutcomes, type AfternoonReport } from "../lib/data";
import type { ResultsView } from "../lib/results";
import { withoutShortWarnings } from "../lib/format";
import ReactionTable from "./ReactionTable.astro";
import ResultsPanel from "./ResultsPanel.astro";

interface Props {
  report: AfternoonReport;
  /** Rapportutfall från dagens uppdateringar (data/results/updates/<datum>T*.json). */
  results: ResultsView | null;
}
const { report, results } = Astro.props;
// Varningar om blankning visas inte (borttagen sedan 2026-11-11; äldre rapporter har kvar felen).
const errors = withoutShortWarnings(report.errors);
---

<div class="afternoon">
  <ReactionTable report={report} outcomes={loadReactionOutcomes(report)} mode="today" headingId="reaktion-rubrik" />

  {
    results && (
      <section class="block" aria-labelledby="eftermiddag-utfall">
        <h3 id="eftermiddag-utfall">Utfall sedan morgonen</h3>
        <ResultsPanel results={results} context="afternoon" />
      </section>
    )
  }

  {
    errors.length > 0 && (
      <details class="errors">
        <summary>Fel vid hämtningen ({errors.length})</summary>
        <ul>
          {errors.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      </details>
    )
  }
</div>

<style>
  .block {
    padding: 12px 0 8px;
  }
  .block > h3 {
    margin: 0 0 6px;
    font-size: 1.1875rem;
  }
  .errors {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
