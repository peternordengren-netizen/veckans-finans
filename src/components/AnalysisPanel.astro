---
/**
 * Fliken "Insyn": veckans insynsaffärer för bolagen i bevakningslistan (data/analysis/<vecka>.json).
 * Blankning räknas inte sedan 2026-11-11 (FI tillåter inte automatisk hämtning); äldre veckor som har
 * blankning i analysfilen visar den som den var.
 */
import type { Analysis, ShortBlock } from "../lib/data";
import { dateRange, shortChange, shortDate } from "../lib/format";
import { holderName, sortBySize } from "../lib/short";

interface Props {
  analysis: Analysis;
}
const { analysis } = Astro.props;
const n = analysis.top_n;

const num2 = new Intl.NumberFormat("sv-SE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const sek = new Intl.NumberFormat("sv-SE", { maximumFractionDigits: 0 });
const kr = (v: number) => `${sek.format(v)} kr`;

function split(block: ShortBlock) {
  const up = block.changes.filter((c) => c.change_pp > 0).sort((a, b) => b.change_pp - a.change_pp).slice(0, n);
  const down = block.changes.filter((c) => c.change_pp < 0).sort((a, b) => a.change_pp - b.change_pp).slice(0, n);
  return { up, down };
}
// Bara äldre veckor har blankning (short_positions, short_aggregate).
const sp = analysis.short_positions;
const sa = analysis.short_aggregate;
const empty = { up: [], down: [] };
const positions = sp ? split(sp) : empty;
const aggregate = sa ? split(sa) : empty;
const period = (b: ShortBlock) => (b.start_as_of && b.end_as_of ? `${shortDate(b.start_as_of)} → ${shortDate(b.end_as_of)}` : "");
const ins = analysis.insider;
---

<p class="intro">
  Ur Finansinspektionens insynsregister, för bolagen i bevakningslistan. Uppgifterna rapporteras av insynspersonerna
  själva och granskas inte av FI före publicering.
  {sp && " Den här veckan finns också blankningen kvar, räknad innan den togs bort 2026-11-11 (förändringen avser läget vid veckans slut jämfört med förra veckans slut)."}
</p>

{
  sp && <h3>Blankning, positioner över 0,5 %</h3>
}
{
  sp && (
  sp.available ? (
    <>
      <p class="period">
        {period(sp)}. Innehavare som ändrat sin position visas under bolaget, största position först.
      </p>
      <div class="two-col">
        {[["Ökade mest", positions.up], ["Minskade mest", positions.down]].map(([title, list]) => (
          <section class="list-block">
            <h4>{title as string}</h4>
            {(list as typeof positions.up).length === 0 ? (
              <p class="empty">Inga förändringar.</p>
            ) : (
              <ol class="changes">
                {(list as typeof positions.up).map((c) => (
                  <li>
                    <div class="row">
                      <span class="co">{c.name} <span class="tk">{c.ticker}</span></span>
                    </div>
                    {(() => {
                      const s = shortChange(c.start_pct, c.end_pct, c.change_pp, { threshold: 0.5 });
                      return (
                        <div class:list={["sub", "chg", c.change_pp > 0 ? "up" : "down"]}>
                          <span class="dir">{s.dir}</span> {s.text}
                          {c.last_change_date && <span class="when-pos"> · senast ändrad {shortDate(c.last_change_date)}</span>}
                        </div>
                      );
                    })()}
                    {c.holders && c.holders.length > 0 && (
                      <ul class="holders">
                        {sortBySize(c.holders).map((h) => {
                          const s = shortChange(h.start_pct, h.end_pct, h.change_pp, { threshold: 0.5, newHolder: true });
                          return (
                            <li>
                              {holderName(h.holder)}: <span class="dir">{s.dir}</span> {s.text}
                              {h.date && <span class="when-pos"> · ändrad {shortDate(h.date)}</span>}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))}
      </div>
    </>
  ) : (
    <p class="note">Inte tillgängligt: {sp.note}.</p>
  )
  )
}

{
  sa && <h3>Blankning, summa av alla positioner över 0,1 %</h3>
}
{
  sa && (
  sa.available ? (
    <>
      <p class="period">{period(sa)}</p>
      <div class="two-col">
        {[["Ökade mest", aggregate.up], ["Minskade mest", aggregate.down]].map(([title, list]) => (
          <section class="list-block">
            <h4>{title as string}</h4>
            {(list as typeof aggregate.up).length === 0 ? (
              <p class="empty">Inga förändringar.</p>
            ) : (
              <ol class="changes">
                {(list as typeof aggregate.up).map((c) => (
                  <li>
                    <div class="row">
                      <span class="co">{c.name} <span class="tk">{c.ticker}</span></span>
                    </div>
                    {(() => {
                      const s = shortChange(c.start_pct, c.end_pct, c.change_pp, { threshold: 0.1 });
                      return (
                        <div class:list={["sub", "chg", c.change_pp > 0 ? "up" : "down"]}>
                          <span class="dir">{s.dir}</span> {s.text}
                        </div>
                      );
                    })()}
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))}
      </div>
    </>
  ) : (
    <p class="note">Inte tillgängligt än: {sa.note}.</p>
  )
  )
}

<h3>Insynsaffärer över {kr(ins.threshold_sek)}</h3>
<p class="period">
  Köp och försäljningar av aktier publicerade under veckan. Aktieprogram, teckningar och reviderade anmälningar ingår inte.
  Affärer utanför handelsplats, till exempel blockaffärer, ingår i beloppen men markeras "utanför börsen".
  {ins.days_missing.length > 0 && <strong> Hämtning saknas för {ins.days_missing.map((d) => shortDate(d)).join(", ")}.</strong>}
</p>
{
  ins.companies.length === 0 ? (
    <p class="empty">Inga insynsaffärer över tröskeln i bevakade bolag.</p>
  ) : (
    <ul class="insider">
      {ins.companies.map((c) => (
        <li class="ins-card">
          <div class="row">
            <span class="co">{c.name} <span class="tk">{c.ticker}</span></span>
            <span class="flags">
              {c.cluster_buy && <span class="flag buy">{c.buyers.length} insynspersoner köpte</span>}
              {c.cluster_sell && <span class="flag sell">{c.sellers.length} insynspersoner sålde</span>}
            </span>
          </div>
          <div class="sub">
            <span class="when">{dateRange(c.transactions.map((t) => t.transaction_date))}:</span>{" "}
            {c.buy_value_sek > 0 && <span>Köp {kr(c.buy_value_sek)}</span>}
            {c.buy_value_sek > 0 && c.sell_value_sek > 0 && <span aria-hidden="true"> · </span>}
            {c.sell_value_sek > 0 && <span>Försäljning {kr(c.sell_value_sek)}</span>}
            {c.sell_value_sek > 0 && c.under_offer && <span class="offer"> · under pågående uppköpsbud</span>}
            {c.transactions.some((t) => t.off_exchange) && (
              <span class="offer"> · inkl. affärer utanför börsen</span>
            )}
          </div>
          <details>
            <summary>{c.transactions.length} {c.transactions.length === 1 ? "transaktion" : "transaktioner"}</summary>
            <ul class="tx">
              {c.transactions.map((t) => (
                <li>
                  <span class:list={["side", t.side === "köp" ? "buy" : "sell"]}>{t.side}</span>
                  {t.person}{t.closely_associated ? " (närstående)" : ""}, {t.position}:
                  {" "}{sek.format(t.volume)} st × {num2.format(t.price)} kr = {kr(t.value_sek)}
                  <span class="date"> · {shortDate(t.transaction_date)}</span>
                  {t.off_exchange && <span class="offer"> · utanför börsen</span>}
                  {t.late_report && (
                    <span class="offer" title={`Publicerad ${shortDate(t.published_date)}, ${t.business_days_to_publication} arbetsdagar efter affären (gränsen är tre)`}>
                      {" "}· sen anmälan
                    </span>
                  )}
                  {t.side === "försäljning" && c.under_offer && <span class="offer"> · under pågående uppköpsbud</span>}
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  )
}

<style>
  .intro {
    margin: 0 0 8px;
    max-width: 70ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  h3 {
    margin: 24px 0 4px;
    font-size: 1.125rem;
  }
  .period,
  .note,
  .empty {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .list-block,
  .ins-card {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 12px 14px;
  }
  h4 {
    margin: 0 0 8px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ol.changes,
  ul.insider,
  ul.holders,
  ul.tx {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ol.changes > li {
    padding: 6px 0;
    border-top: 1px solid var(--border);
  }
  ol.changes > li:first-child {
    border-top: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .co {
    font-weight: 600;
  }
  .tk {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .chg {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .chg.up {
    color: var(--neg); /* mer blankning */
  }
  .chg.down {
    color: var(--pos);
  }
  .sub,
  .holders li,
  .tx li {
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .holders {
    margin-top: 2px !important;
  }
  ul.insider {
    display: grid;
    gap: 10px;
  }
  .flag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .flag.buy {
    background: var(--direct-bg);
    color: var(--direct-fg);
  }
  .flag.sell {
    background: var(--indirect-bg);
    color: var(--indirect-fg);
  }
  .offer {
    font-style: italic;
  }
  .dir {
    font-weight: 600;
    white-space: nowrap;
  }
  .when {
    font-weight: 600;
  }
  .when-pos {
    font-weight: 400;
    color: var(--muted);
  }
  details {
    margin-top: 6px;
    font-size: 0.875rem;
  }
  summary {
    cursor: pointer;
    color: var(--accent);
  }
  .tx li {
    padding: 4px 0;
  }
  .side {
    display: inline-block;
    min-width: 6.5em;
    font-weight: 600;
  }
  .side.buy {
    color: var(--pos);
  }
  .side.sell {
    color: var(--neg);
  }
</style>
