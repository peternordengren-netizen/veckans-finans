  }

  <div class="table-outer" data-table-outer>
    <div class="table-wrap" data-table-wrap>
      <table>
        <thead>
          <tr>
            {
              columns.map((c) => (
                <th scope="col" class:list={[`col-${c.key}`, "pb" in c && "col-pb", "bb" in c && "col-bb", "nopb" in c && "col-nopb"]} data-key={c.key} data-type={c.type} aria-sort="none">
                  <button type="button" title={"title" in c ? c.title : undefined}>{c.label}</button>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            swing.rows.map((r) => (
              <tr
                data-labels={r.labels.join(" ")}
                data-pb-invalid={r.labels.some((l) => pbLabels.includes(l)) && todayInvalid(r.pullback?.today?.status) ? "1" : undefined}
