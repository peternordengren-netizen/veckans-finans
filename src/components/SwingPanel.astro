---
/**
 * Fliken Swing: lägesmått per bolag ur dagsdata (scripts/swing.py, uppdateras varje morgon) och beskrivande
 * etiketter, i en sorterbar och filtrerbar tabell med fast rubrikrad. Under tabellen historiken per etikett
 * (scripts/swing_history.py). Ett informationsverktyg: etiketterna beskriver vad som hänt, inga uppmaningar.
 */
import type { PullbackSummary, SwingView } from "../lib/data";
import Momentum from "./SwingMomentum.astro";
import { shortDate } from "../lib/format";
import { signedPct } from "../lib/signals";
import {
  MIN_CASES, altStopText, decidedShareText, labelClass, labelCounts, levelText, missingText, netText, priceText,
  reportText, resistanceRText, riskText, shareText, bollingerSourceText, chipText, pctBText, signalText,
  TODAY_STATUS, todayInvalid, todayLines, todayOrder, bbLevelText, breakoutLines, todayVolumeText, volumeRuleLines,
  momentumText, rText, rankText, rankTitle, srDistText, srInsideText, srKindText, srLevelText, upperRText, vsBaseText,
} from "../lib/swing";

interface Props {
  swing: SwingView;
}
const { swing } = Astro.props;
const order = Object.keys(swing.labels);
const counts = labelCounts(swing.rows, order);
const withLabel = swing.rows.filter((r) => r.labels.length > 0).length;
const num = (v: number | null, digits = 1) =>
  v === null ? "–" : new Intl.NumberFormat("sv-SE", { minimumFractionDigits: digits, maximumFractionDigits: digits }).format(v);
const v = (x: number | null) => (x === null ? "" : String(x));
const t = swing.thresholds;
const h = swing.history;
const pt = t.pullback;
const pbHist = h?.pullback ?? null;
// Strategier i rullistan, med antal bolag som matchar någon av strategins etiketter.
const strategies = Object.entries(swing.strategies).map(([key, s]) => ({
  key,
  ...s,
  count: swing.rows.filter((r) => r.labels.some((l) => s.labels.includes(l))).length,
}));
const pbLabels = swing.strategies.pullback?.labels ?? [];

const columns = [
  { key: "name", label: "Bolag", type: "text" },
  { key: "labels", label: "Etiketter", type: "text" },
  { key: "ma20", label: "Mot 20 d MA", type: "num", nopb: true },
  { key: "ma50", label: "Mot 50 d MA", type: "num", nopb: true },
  { key: "rsi2", label: "RSI(2)", type: "num", nopb: true },
  { key: "rsi14", label: "RSI(14)", type: "num", nopb: true },
  { key: "atr", label: "ATR(14)", type: "num", nopb: true, title: "Genomsnittlig daglig rörelse, i procent av kursen" },
  { key: "volume", label: "Omsättning", type: "num", nopb: true, title: "Senaste dagen mot snittet för de 20 dagarna före" },
  { key: "report", label: "Sedan rapport", type: "num", nopb: true },
  { key: "short", label: "Blankning", type: "num", nopb: true, title: "Sammanlagd blankning enligt Finansinspektionen" },
  { key: "support", label: "Närmaste stöd", type: "num", title: "Närmaste stöd under gårdagens stängning och avståndet dit" },
  { key: "resistance", label: "Närmaste motstånd", type: "num", title: "Närmaste motstånd över gårdagens stängning och avståndet dit" },
  // Strategin Pullback i trend: visas bara när strategin är vald i rullistan.
  { key: "pb-rank", label: "Rang", type: "num", pb: true, title: "Flest uppfyllda kriterier först (1–5 för de fem med flest, med antalet kriterier); vid lika antal mest utrymme till motståndet i R. Ingen värdering eller rekommendation" },
  { key: "pb-today", label: "Status i dag", type: "num", pb: true, title: "Dagens high, low och senaste kurs mot triggernivån (gårdagens high), stoppet och 50 MA, vid Bollingerkontrollerna 09:20 och 13:20. Kurserna är fördröjda ca 15 minuter. Ogiltiga kandidater sorteras sist" },
  { key: "pb-entry", label: "Ingång", type: "num", pb: true, title: "Vändsignal och nivån rekylen nådde; triggernivån (gårdagens high) vid vändsignal, annars gårdagens stängning som referens. Sorteras på nivån" },
  { key: "pb-stop", label: "Stopp", type: "num", pb: true, title: "Stoppnivån och avståndet dit (1 R) i procent och ATR(14); stoppet under närmaste stöd som alternativ stoppnivå i procent. Sorteras på avståndet i procent" },
  { key: "pb-target", label: "Mål", type: "num", pb: true, title: "Föregående topp, 2R och 3R, övre Bollingerbandet (⚠ = kursen vid eller över) och närmaste motstånd i R (samma R som stoppet). Sorteras på avståndet till övre bandet i R" },
  // Strategin Rekyl efter Bollingerutbrott: visas bara när den är vald.
  { key: "bb-rank", label: "Rang", type: "num", bb: true, title: "Flest uppfyllda kriterier först (1–5 för de fem med flest, med antalet kriterier); vid lika antal mest utrymme till utbrottets högsta high i R. Ingen värdering eller rekommendation" },
  { key: "bb-today", label: "Status i dag", type: "num", bb: true, title: "Dagens high, low och senaste kurs mot triggernivån (gårdagens high), stoppet och 50 MA, vid Bollingerkontrollerna 09:20 och 13:20. Kurserna är fördröjda ca 15 minuter. Ogiltiga kandidater sorteras sist" },
  { key: "bb-entry", label: "Utbrott och rekyl", type: "num", bb: true, title: "Utbrottsdagen (rapportdag?), omsättningen i rekylen, vändsignal och nivån rekylen nådde; triggernivån vid vändsignal, annars gårdagens stängning som referens. Sorteras på dagar sedan utbrottet" },
  { key: "bb-stop", label: "Stopp", type: "num", bb: true, title: "Rekylens lägsta low och avståndet dit (1 R) i procent och ATR(14). Sorteras på avståndet i procent" },
  { key: "bb-target", label: "Mål", type: "num", bb: true, title: "Utbrottets högsta high i R, 2R och 3R, och övre Bollingerbandet (⚠ = kursen vid eller över). Sorteras på utrymmet till utbrottets high i R" },
] as const;
const bbCheck = swing.bollingerCheck;
const bbLabels = swing.strategies.bbrekyl?.labels ?? [];
const bt = t.bbrekyl;
const bbTop = bt?.ranking.top ?? 5;
const bbHist = h?.bbrekyl ?? null;
const rankTop = t.ranking?.top ?? 5;
const rankHist = pbHist?.ranking ?? null;
---

<div class="swing" data-swing>
  <p class="lead">
    Lägesmått per bolag vid stängningen {swing.asOf ? shortDate(swing.asOf) : "–"}, uppdaterade varje morgon. Etiketterna
    beskriver vad som hänt i kursen, omsättningen och rapporterna. De är inga uppmaningar. Historiken under tabellen visar
    hur ofta varje etikett det senaste året följts av att aktien gått bättre än index, jämfört med alla dagar, och för
    strategin Pullback i trend hur ofta 2R nåddes före stoppet. Historiken säger inget om hur det går nästa gång.
  </p>
  {
    swing.expectedDay && swing.asOf !== swing.expectedDay && (
      <p class="warn-box">
        Måtten gäller stängningen {swing.asOf ? shortDate(swing.asOf) : "– ingen dag"}, inte förra handelsdagen
        ({shortDate(swing.expectedDay)}): Yahoo hade
        {swing.coverage ? ` ${swing.coverage.with_expected} av ${swing.coverage.of} bolags` : " inte"} kurser för den dagen
        när fliken uppdaterades.
      </p>
    )
  }
  <details class="legend">
    <summary>Så räknas måtten och etiketterna</summary>
    <ul>
      <li><strong>Mot 20 d / 50 d MA:</strong> stängningskursen mot det glidande medelvärdet för 20 respektive 50 handelsdagar.</li>
      <li><strong>RSI(2) och RSI(14):</strong> relativ styrka över 2 och 14 dagar (0–100).</li>
      <li><strong>ATR(14):</strong> genomsnittlig daglig rörelse de senaste 14 dagarna, i procent av kursen.</li>
      <li><strong>Omsättning:</strong> senaste dagens omsättning mot snittet för de 20 handelsdagarna före.</li>
      <li>
        <strong>Utbrott:</strong> stängningen ligger över det högsta värdet de 20 handelsdagarna före; "hög omsättning"
        när omsättningen är minst {num(t.volume_ratio, 0)} gånger snittet.
      </li>
      <li><strong>RSI(2) under {num(t.rsi2_low, 0)} / över {num(t.rsi2_high, 0)}:</strong> kraftig nedgång respektive uppgång de senaste dagarna.</li>
      <li><strong>Trend upp / ned:</strong> kursen över (under) 20 dagars MA, som ligger över (under) 50 dagars MA.</li>
      <li>
        <strong>Golden cross / Death cross:</strong> 50 dagars glidande medelvärde har korsat upp över (golden) eller ned
        under (death) 200 dagars medelvärde någon av de 10 senaste handelsdagarna, gårdagen inräknad. Korsningsdagen är
        den första dagen 50 MA ligger över (under) 200 MA efter en dag då det låg tvärtom. Antalet dagar sedan
        korsningen står inom parentes ("i går" = gårdagen). Kräver 201 handelsdagars historik.
      </li>
      <li>
        <strong>Vid övre Bollingerband:</strong> gårdagens stängning ligger vid eller över det övre Bollingerbandet,
        snittet av de 20 senaste stängningskurserna (gårdagens inräknad) plus 2 standardavvikelser.
      </li>
      <li>
        <strong>Efter rapport:</strong> rapport inom {t.report_days} handelsdagar (reaktionsdagen räknas som dag 0), med
        utfallet mot förväntan för vinst per aktie där det finns.
      </li>
      <li>
        <strong>Blankning:</strong> sammanlagd blankning enligt Finansinspektionens register{swing.shortAsOf ? ` ${shortDate(swing.shortAsOf)}` : ""}.
      </li>
    </ul>
    {
      swing.thresholds.levels && (
        <>
          <p class="legend-head"><strong>Stöd och motstånd</strong> (alla bolag)</p>
          <ul>
            <li>
              <strong>Vändpunkter:</strong> de senaste {swing.thresholds.levels.lookback} handelsdagarna fram till gårdagen.
              En dag är en botten om dess lägsta kurs (low) är lägst bland de {swing.thresholds.levels.pivot} dagarna före
              och de {swing.thresholds.levels.pivot} dagarna efter, och en topp om dess högsta kurs (high) är högst bland
              samma dagar. De {swing.thresholds.levels.pivot} sista dagarna kan därför inte bli vändpunkter än.
            </li>
            <li>
              <strong>Zoner:</strong> alla vändpunkter, bottnar och toppar, sorteras efter pris. En zon börjar vid den
              lägsta, och nästa punkt tas med så länge den ligger högst {num(swing.thresholds.levels.merge_atr, 0)} ATR(14)
              över zonens nedre kant; annars börjar en ny zon. Zonens kanter är dess lägsta och högsta punkt, och antalet
              vändningar är antalet punkter i den.
            </li>
            <li>
              <strong>Stöd och motstånd:</strong> en zon under gårdagens stängning är stöd, en zon över är motstånd. Ligger
              stängningen i zonen avgör zonens mitt (medelvärdet av punkterna). En bruten topp blir alltså stöd och en
              bruten botten motstånd. 20 dagars EMA och 50 och 200 dagars MA räknas också, som stöd under kursen och
              motstånd över, utom när medelvärdet ligger inne i en zon: då täcker zonen redan det prisområdet. Därmed
              ligger stödet aldrig över motståndet.
            </li>
            <li>
              <strong>Närmaste stöd</strong> är det högsta stödet under kursen (avstånd till dess övre kant),
              <strong> närmaste motstånd</strong> det lägsta över (avstånd till dess nedre kant), i procent och i ATR(14).
              Ligger stängningen inne i zonen står "inne i stödzon" eller "inne i motståndszon" med zonens kanter.
            </li>
            <li>
              <strong>Alternativt stopp under stöd</strong> (kolumnen Stopp): närmaste stödets nedre kant minus
              {" "}{num(swing.thresholds.levels.stop_buffer_atr)} ATR, med avståndet från referensen i procent. Det är bara
              en jämförelse med strategins stopp och har inget eget R.
            </li>
          </ul>
        </>
      )
    }
    {
      pt && (
        <>
          <p class="legend-head"><strong>Strategin Pullback i trend</strong> (välj den i rullistan)</p>
          <ul>
            <li>
              <strong>Trend:</strong> stängningen ligger över 50 och 200 dagars glidande medelvärde, och 50 dagars MA ligger
              över 200 dagars MA. Kräver 200 handelsdagars historik. Kurserna justeras för utdelningar och splittar som
              övriga mått.
            </li>
            <li>
              <strong>Rekyl i trend:</strong> gårdagens lägsta kurs (low) ligger högst {num(pt.touch_pct, 0)} % från 20 dagars
              EMA eller 50 dagars MA, och gårdagens stängning ligger över samma nivå. Når rekylen båda nivåerna används den
              lägre.
            </li>
            <li>
              <strong>Rekyl med vändsignal:</strong> som ovan, och gårdagens candle är en hammer eller en bullish engulfing.
              Triggernivån är gårdagens högsta kurs (high).
              <ul>
                <li>
                  <em>Hammer:</em> den nedre skuggan (lägsta av öppning och stängning minus low) är minst
                  {" "}{num(pt.hammer_shadow, 0)} gånger kroppen (skillnaden mellan öppning och stängning), och den övre skuggan
                  (high minus högsta av öppning och stängning) är högst {num(pt.hammer_upper * 100, 0)} % av dagens spann
                  (high minus low).
                </li>
                <li>
                  <em>Bullish engulfing:</em> förra dagen stängde under sin öppning och gårdagen över sin, och gårdagens kropp
                  omsluter förra dagens: gårdagens öppning är högst förra dagens stängning och gårdagens stängning minst förra
                  dagens öppning.
                </li>
              </ul>
            </li>
            <li>
              <strong>Ingång:</strong> vändsignalen, nivån rekylen nådde och triggernivån vid vändsignal, annars gårdagens
              stängning som referens. Under den RSI(14) och Stoch RSI (3, 3, 14, 14, %K/%D), med ⚠ när RSI(14) är över 70
              eller Stoch RSI %K över 80. De räknas på gårdagens stängning och, vid Bollingerkontrollerna 09:20 och 13:20,
              med dagens kurs (fördröjd ca 15 minuter). De påverkar inte rang eller krav, och visas också i Rekyl efter
              Bollingerutbrott.
              <strong> Stopp:</strong> lägsta low under rekylen, alltså sedan den högsta toppen de senaste
              {" "}{pt.stop_days} handelsdagarna, eller MA-nivån om den ligger lägre. Under nivån står avståndet från
              referensen till stoppet (1 R) i procent och i ATR(14).
              <strong> Mål:</strong> föregående topp (högsta high de senaste {pt.top_days} handelsdagarna), 2R och 3R
              (referensen plus två respektive tre gånger R), övre Bollingerbandet och närmaste motstånd i R.
            </li>
            <li>
              <strong>Ett enda R:</strong> R är alltid referensen (triggernivån vid vändsignal) minus strategins stopp, i
              stoppet, 2R och 3R, Bollingerbandet, motståndet och rangkriterierna.
              <strong> Motstånd i R</strong> (kolumnen Mål) är (närmaste motstånds nedre kant − referensen) / R, samma
              mått som rangkriteriet; negativt om motståndet ligger under referensen. Ligger kursen inne i motståndszonen
              räknas till zonens övre kant, där zonen tar slut.
            </li>
            {
              Object.keys(swing.rankingCriteria).length > 0 && t.ranking && (
                <li>
                  <strong>Rang (flest kriterier):</strong> en poäng per uppfyllt kriterium, räknat på gårdagens stängning:
                  <ol>
                    <li>vändsignal (hammer eller bullish engulfing)</li>
                    <li>
                      närmaste motstånd minst {num(t.ranking.resistance_r, 0)}R över referensen, eller inget motstånd inom 120
                      dagar (R = referens minus stopp; till motståndszonens övre kant om kursen ligger inne i den)
                    </li>
                    <li>
                      kursen i en stödzon eller högst {num(t.ranking.support_atr, 0)} ATR över dess övre kant (bara zoner av
                      tidigare vändpunkter, inte medelvärdena)
                    </li>
                    <li>minst {num(t.ranking.bollinger_r, 0)}R kvar till övre Bollingerbandet</li>
                    <li>stoppet högst {num(t.ranking.stop_atr)} ATR från referensen</li>
                    <li>50 dagars MA högre än för {t.ranking.ma50_days} handelsdagar sedan</li>
                  </ol>
                  Flest uppfyllda kriterier först; vid lika antal mest utrymme till motståndet i R (inget motstånd först).
                  De {rankTop} med flest kriterier får rang 1–{rankTop}. Rangen säger bara hur många kriterier som är
                  uppfyllda, inte hur det går. Historiken under tabellen visar hur ofta de {rankTop} med flest kriterier per
                  dag nått 2R jämfört med övriga.
                </li>
              )
            }
            <li>
              <strong>Bollinger:</strong> banden är snittet av de 20 senaste stängningskurserna plus och minus 2
              standardavvikelser. <em>%B</em> är kursens läge mellan banden: (kurs − undre bandet) / (övre − undre), så 0 är
              undre bandet och 1 övre; utanför banden blir det under 0 eller över 1. Avståndet till övre bandet i R är
              (övre bandet − kursen) / R, med R från kolumnen Stopp; "över" när kursen ligger ovanför bandet.
              ⚠ markerar en kandidat vid eller över övre bandet. Morgonens värden gäller gårdagens stängning.
              Bollingerkontrollerna 09:20 och 13:20 räknar om banden med dagens kurs (fördröjd ca 15 minuter, faktiska
              kurser) och visar kontrollens tid i cellen.
            </li>
            <li>
              <strong>Status i dag</strong> uppdateras vid Bollingerkontrollerna 09:20 och 13:20, med samma hämtning:
              dagens high, low och senaste kurs (fördröjda ca 15 minuter) mot triggernivån (gårdagens high), strategins
              stopp och 50 dagars MA. I den här ordningen:
              <ul>
                <li><em>{TODAY_STATUS.below_stop}:</em> dagens low under stoppet.</li>
                <li><em>{TODAY_STATUS.below_ma50}:</em> senaste kursen under 50 dagars MA.</li>
                <li><em>{TODAY_STATUS.late}:</em> senaste kursen över triggernivån plus 1 R.</li>
                <li>
                  <em>{TODAY_STATUS.triggered}:</em> dagens high över triggernivån, med tiden för kontrollen där det syntes
                  första gången (den exakta tiden är okänd).
                </li>
                <li><em>{TODAY_STATUS.waiting}:</em> dagens high högst triggernivån.</li>
              </ul>
              Dagens high och low gäller hela dagen, så en bruten trigger och ett underskridet stopp står kvar. Ogiltiga
              kandidater sorteras sist. Före 09:20 står "–". Windows-notisen vid varje kontroll listar ändringarna sedan
              föregående kontroll.
            </li>
            <li>
              <strong>Historiken</strong> under tabellen följer varje sådan dag det senaste året, ett fall i taget per bolag.
              Fallet startar på nästa dags öppning; vid vändsignal i stället när triggernivån nås inom {pt.trigger_days}
              {" "}handelsdagar, annars räknas det som ej utlöst. Det avgörs när 2R eller stoppet nås. Nås båda samma dag räknas
              stoppet först, och öppnar en dag bortom nivån gäller öppningen. Efter {pt.max_days} handelsdagar utan
              avgörande räknas fallet som öppet. Courtage, spread och glidning ingår inte.
            </li>
          </ul>
        </>
      )
    }
    {
      bt && (
        <>
          <p class="legend-head"><strong>Strategin Rekyl efter Bollingerutbrott</strong> (välj den i rullistan)</p>
          <ul>
            <li>
              <strong>Utbrottsdag:</strong> en av de {bt.breakout_days} handelsdagarna före gårdagen där stängningen låg över
              övre Bollingerbandet ({bt.bb_period} dagar, {num(bt.bb_width, 0)} standardavvikelser), omsättningen var minst
              {" "}{num(bt.base_volume_ratio ?? bt.volume_ratio)} gånger snittet för de {bt.volume_days} dagarna före, och stängningen låg över 50
              dagars MA. Finns flera gäller den senaste. "Rapportdag" när utbrottsdagen var reaktionsdag för en rapport, med
              utfallet mot förväntan för vinst per aktie där det finns.
            </li>
            {
              bt.red_volume_ratio !== undefined && (
                <li>
                  <strong>Volymvillkoren</strong> visas med ✓ (uppfyllt) eller ✗ och siffrorna i kolumnen "Utbrott och
                  rekyl". Ingen röd dag i rekylen med hög omsättning är ett krav; de tre andra är rangkriterier:
                  <ol>
                    <li>utbrottsdagens omsättning minst {num(bt.volume_ratio)} gånger 20-dagarssnittet (rangkriterium)</li>
                    <li>
                      ingen röd dag i rekylen (stängning under öppningen) med omsättning över {num(bt.red_volume_ratio)} gånger
                      den dagens 20-dagarssnitt (krav)
                    </li>
                    <li>snittomsättningen under rekyldagarna under 20-dagarssnittet före utbrottsdagen (rangkriterium)</li>
                    <li>
                      summan av omsättningen på uppdagar i rekylen (stängning över föregående dags) minst lika stor som på
                      neddagar; oförändrade dagar räknas inte (rangkriterium)
                    </li>
                  </ol>
                </li>
              )
            }
            <li>
              <strong>Rekyl:</strong> gårdagens low ligger högst {num(bt.touch_pct, 0)} % från mittbandet (20 dagars MA) eller
              20 dagars EMA, eller mellan dem. Ingen stängning sedan utbrottet har legat under utbrottsdagens low eller under
              mittbandet. Under utbrottet står om snittomsättningen i rekylen varit lägre än på utbrottsdagen.
            </li>
            <li>
              <strong>Vändsignal</strong> som i Pullback i trend (hammer eller bullish engulfing). Triggernivån är gårdagens
              high; utan vändsignal är gårdagens stängning referens.
            </li>
            <li>
              <strong>Stopp:</strong> rekylens lägsta low, dagarna efter utbrottet till och med gårdagen. R är referensen
              minus stoppet, samma R överallt. <strong>Mål:</strong> utbrottets högsta high (utbrottsdagen till och med
              gårdagen) med avståndet i R, 2R och 3R, och övre Bollingerbandet.
            </li>
            {
              Object.keys(swing.bbrekylCriteria).length > 0 && (
                <li>
                  <strong>Rang (flest kriterier):</strong> en poäng per uppfyllt kriterium, räknat på gårdagens stängning:
                  <ol>
                    {Object.values(swing.bbrekylCriteria).map((text) => <li>{text}</li>)}
                  </ol>
                  Vid lika antal mest utrymme till utbrottets high i R först. De {bbTop} med flest kriterier får rang
                  1–{bbTop}. Rangen säger bara hur många kriterier som är uppfyllda, inte hur det går.
                </li>
              )
            }
            <li>
              <strong>Status i dag</strong> räknas som för Pullback i trend vid Bollingerkontrollerna 09:20 och 13:20
              (fördröjda ca 15 minuter), med triggernivån gårdagens high, rekylens stopp och gårdagens 50 MA. Under
              statusen står dagens omsättning hittills mot normalt vid samma tid: summan av dagens 15-minutersstaplar mot
              snittet för de 20 senaste handelsdagarna fram till samma klockslag. Dagens sista stapel kan vara ofullständig.
            </li>
          </ul>
        </>
      )
    }
  </details>

  <div class="controls">
    <label>
      Visa
      <select data-label-filter>
        <option value="" selected>alla bolag ({swing.rows.length})</option>
        <option value="*">bolag med etikett ({withLabel})</option>
        {
          strategies.length > 0 && (
            <optgroup label="Strategi">
              {strategies.map((s) => (
                <option value={`strategi:${s.key}`} data-strategy={s.key} data-strategy-labels={s.labels.join(" ")}>
                  {s.name} ({s.count})
                </option>
              ))}
            </optgroup>
          )
        }
        <optgroup label="Etikett">
          {counts.map((c) => (
            <option value={c.label} disabled={c.count === 0}>
              {swing.labels[c.label]} ({c.count})
            </option>
          ))}
        </optgroup>
      </select>
    </label>
    <span class="shown" data-shown aria-live="polite">Visar alla {swing.rows.length} bolag</span>
    <span class="bb-note">
      Bollinger och status i dag: {bbCheck ? `senaste kontrollen ${bollingerSourceText(bbCheck.checked_at)}. ${bbCheck.delay_note}` : "gårdagens stängning, ingen kontroll i dag än (09:20 och 13:20). Kurserna är fördröjda ca 15 minuter."}
    </span>
  </div>

  {
    (swing.missing.length > 0 || swing.delisted.length > 0) && (
      <p class="missing-note">
        {swing.missing.length > 0 && (
          <>
            Saknas i tabellen:{" "}
            {swing.missing.map((m, i) => (
              <>
                {i > 0 && "; "}
                {m.name} ({m.ticker}): {missingText(m)}
              </>
            ))}.{" "}
          </>
        )}
        {swing.delisted.length > 0 && (
          <>
            Avnoterade, räknas inte:{" "}
            {swing.delisted.map((d, i) => (
              <>
                {i > 0 && "; "}
                {d.name} ({d.ticker}), sista handelsdag {shortDate(d.last_day)}{" "}
