                  const l = r.sr?.[side] ?? null;
                  const inside = srInsideText(l, side);
                  return (
                    <td class:list={["num sr", inside && "inside"]} data-v={v(l?.dist_pct ?? null)} title={l ? srLevelText(l, side) : undefined}>
                      {inside ? (
                        <>
                          {inside}
                          <span class="sub">{l!.touches} vändn.</span>
                        </>
                      ) : (
                        <>
                          {l ? priceText(side === "support" ? l.high : l.low) : "–"}
                          {l && <span class="sub">{srKindText(l)}</span>}
                          {l && <span class="sub">{srDistText(l.dist_pct, l.dist_atr, side)}</span>}
                        </>
                      )}
                    </td>
                  );
                })}
                {(() => {
                  const lv = r.labels.some((l) => pbLabels.includes(l)) ? (r.pullback?.levels ?? null) : null;
                  const bb = lv ? (r.pullback?.bollinger ?? null) : null;
                  const srStop = lv && r.sr?.stop != null ? r.sr.stop : null;
                  const rk = lv ? (r.pullback?.rank ?? null) : null;
                  const rt = rk ? rankText(rk.rank, rk.score, Object.keys(swing.rankingCriteria).length, rankTop) : null;
                  const td = lv ? (r.pullback?.today ?? null) : null;
                  const tl = td ? todayLines(td) : null;
                  return (
                    <>
                      <td
                        class:list={["num col-pb rank", rk && rk.rank <= rankTop && "top"]}
                        data-v={v(rk ? -rk.rank : null)}
                        title={rk ? rankTitle(rk.criteria, swing.rankingCriteria) : undefined}
                      >
                        {rt ? (
                          <>
                            <span class="line">{rt.main}</span>
                            <span class="sub">{rt.sub}</span>
                          </>
                        ) : "–"}
                      </td>
                      <td
                        class:list={["num col-pb pb today", td && `today-${td.status}`]}
                        data-v={v(td ? todayOrder(td.status) : null)}
                        title={lv && !td ? "Ingen kontroll i dag än (09:20 och 13:20)" : undefined}
                      >
                        {tl ? (
                          <>
                            <span class="line">{tl.main}</span>
                            {tl.seen && <span class="sub">{tl.seen}</span>}
                            <span class="sub">{tl.prices}</span>
                          </>
                        ) : "–"}
                      </td>
                      <td class="num col-pb pb" data-v={v(lv?.ref ?? null)}>
                        {lv ? (
                          <>
                            <span class="line">{lv.signal ? signalText(lv.signal) : "Ingen vändsignal"}</span>
                            <span class="sub">vid {levelText(lv.level)}</span>
                            <span class="line">{lv.trigger !== null ? "Trigger" : "Referens"} {priceText(lv.ref)}</span>
                            {lv.trigger === null && <span class="sub">gårdagens stängning</span>}
                            <Momentum m={r.momentum} />
                          </>
                        ) : "–"}
                      </td>
                      <td class="num col-pb pb" data-v={v(lv?.risk_pct ?? null)}>
                        {lv ? (
                          <>
                            <span class="line">{priceText(lv.stop)}</span>
                            <span class="sub">{riskText(lv.risk_pct, lv.risk_atr)}</span>
                            {altStopText(lv.ref, srStop) && <span class="sub">{altStopText(lv.ref, srStop)}</span>}
                          </>
                        ) : "–"}
                      </td>
                      <td
                        class:list={["num col-pb pb", bb?.at_upper && "bb-warn"]}
                        data-v={v(bb?.upper_r ?? null)}
                        title={bb?.at_upper ? "Kursen är vid eller över övre Bollingerbandet" : undefined}
                      >
                        {lv ? (
                          <>
                            <span class="line">Topp {priceText(lv.top)}</span>
                            <span class="sub">2R {priceText(lv.r2)} · 3R {priceText(lv.r3)}</span>
                            {bb && (
                              <span class="line">
                                {bb.at_upper && <span class="warn-icon" aria-label="Vid eller över övre bandet">⚠ </span>}
                                Övre band {priceText(bb.upper)}
                              </span>
                            )}
                            {bb && (
                              <span class="sub">
                                {upperRText(bb.upper_r)} · {pctBText(bb.pct_b)} · {bollingerSourceText(bb.checked_at)}
                              </span>
                            )}
                            <span class="sub">
                              Motstånd {resistanceRText(rk?.measures)}
                              {r.sr?.resistance?.inside && " (till zonens övre kant)"}
                            </span>
                          </>
                        ) : "–"}
                      </td>
                    </>
                  );
                })()}
                {(() => {
                  const lv = r.labels.some((l) => bbLabels.includes(l)) ? (r.bbrekyl?.levels ?? null) : null;
                  const pos = lv ? (r.bbrekyl?.bollinger ?? null) : null;
                  const rk = lv ? (r.bbrekyl?.rank ?? null) : null;
                  const rt = rk ? rankText(rk.rank, rk.score, Object.keys(swing.bbrekylCriteria).length, bbTop) : null;
                  const td = lv ? (r.bbrekyl?.today ?? null) : null;
                  const tl = td ? todayLines(td) : null;
                  const bo = lv ? breakoutLines(lv.breakout, lv.lower_volume, shortDate) : null;
                  const vr = lv?.volume
                    ? volumeRuleLines(lv.volume, {
                      volumeRatio: bt?.volume_ratio ?? 2, redRatio: bt?.red_volume_ratio ?? 1.5,
                      required: bt?.required_rules ?? ["r1", "r2", "r3", "r4"],
                    })
                    : null;
                  const tv = td ? todayVolumeText(td.volume) : null;
                  return (
                    <>
                      <td
                        class:list={["num col-bb rank", rk && rk.rank <= bbTop && "top"]}
                        data-v={v(rk ? -rk.rank : null)}
                        title={rk ? rankTitle(rk.criteria, swing.bbrekylCriteria) : undefined}
                      >
                        {rt ? (
                          <>
                            <span class="line">{rt.main}</span>
                            <span class="sub">{rt.sub}</span>
                          </>
                        ) : "–"}
                      </td>
                      <td
                        class:list={["num col-bb pb today", td && `today-${td.status}`]}
                        data-v={v(td ? todayOrder(td.status) : null)}
                        title={lv && !td ? "Ingen kontroll i dag än (09:20 och 13:20)" : undefined}
                      >
                        {tl ? (
                          <>
                            <span class="line">{tl.main}</span>
                            {tl.seen && <span class="sub">{tl.seen}</span>}
                            <span class="sub">{tl.prices}</span>
                            {tv && <span class="sub">{tv}</span>}
                          </>
                        ) : "–"}
                      </td>
                      <td class="num col-bb pb" data-v={v(lv ? -lv.breakout.days_ago : null)}>
                        {lv && bo ? (
                          <>
                            <span class="line">{bo.main}</span>
                            {bo.report && <span class="sub">{bo.report}</span>}
                            {vr ? vr.map((x) => (
                              <span class:list={["sub rule", x.ok ? "rule-ok" : "rule-no"]}>
                                <span aria-label={x.ok ? "uppfyllt" : "ej uppfyllt"}>{x.ok ? "✓" : "✗"}</span> {x.text}
                              </span>
                            )) : <span class="sub">{bo.volume}</span>}
                            <span class="line">{lv.signal ? signalText(lv.signal) : "Ingen vändsignal"}, vid {bbLevelText(lv.level)}</span>
                            <span class="sub">{lv.trigger !== null ? "Trigger" : "Referens"} {priceText(lv.ref)}{lv.trigger === null ? " (gårdagens stängning)" : ""}</span>
                            <Momentum m={r.momentum} />
                          </>
                        ) : "–"}
                      </td>
                      <td class="num col-bb pb" data-v={v(lv?.risk_pct ?? null)}>
                        {lv ? (
                          <>
                            <span class="line">{priceText(lv.stop)}</span>
                            <span class="sub">{riskText(lv.risk_pct, lv.risk_atr)}</span>
                            <span class="sub">rekylens lägsta low</span>
                          </>
                        ) : "–"}
                      </td>
                      <td
                        class:list={["num col-bb pb", pos?.at_upper && "bb-warn"]}
                        data-v={v(lv?.target_r ?? null)}
                        title={pos?.at_upper ? "Kursen är vid eller över övre Bollingerbandet" : undefined}
                      >
                        {lv ? (
                          <>
                            <span class="line">Utbrottets high {priceText(lv.target)}</span>
                            <span class="sub">{rText(lv.target_r)} från referensen</span>
                            <span class="sub">2R {priceText(lv.r2)} · 3R {priceText(lv.r3)}</span>
                            {pos && (
                              <span class="line">
                                {pos.at_upper && <span class="warn-icon" aria-label="Vid eller över övre bandet">⚠ </span>}
                                Övre band {priceText(pos.upper)}
                              </span>
                            )}
                            {pos && (
                              <span class="sub">
                                {upperRText(pos.upper_r)} · {pctBText(pos.pct_b)} · {bollingerSourceText(pos.checked_at)}
                              </span>
                            )}
                          </>
                        ) : "–"}
                      </td>
                    </>
                  );
                })()}
              </tr>
            ))
          }
        </tbody>
      </table>
