---
/**
 * En veckas sida: rubrik, veckoväljare, mock-banderoll och en flik per sektor.
 * Utan JavaScript visas alla sektorer under varandra; med JavaScript blir de flikar.
 */
import Base from "../layouts/Base.astro";
import AnalysisPanel from "./AnalysisPanel.astro";
import CalendarPanel from "./CalendarPanel.astro";
import SignalsPanel from "./SignalsPanel.astro";
import SwingPanel from "./SwingPanel.astro";
import ResultsPanel from "./ResultsPanel.astro";
import ValuationPanel from "./ValuationPanel.astro";
import CompanyCard from "./CompanyCard.astro";
import MorningReportView from "./MorningReport.astro";
import { weekdayDate } from "../lib/calendar";
import AfternoonReportView from "./AfternoonReport.astro";
import {
  formatDate,
  listMorningDates,
  loadAfternoonBefore,
  loadMorning,
  loadLatestSwing,
  loadResults,
  loadUpdateResults,
  weekLabel,
  type AfternoonReport,
  type MorningReport,
  type WeekView,
} from "../lib/data";
import { shortDate } from "../lib/format";
import { describePolicyRate, formatRate, pendingDecisionText } from "../lib/policyRate";

interface Props {
  view: WeekView;
  weeks: string[];
  /** Startsidan: senaste morgonrapporten visas överst, före veckan och flikarna. */
  morning?: MorningReport | null;
  /** Startsidan: eftermiddagsuppdateringen, ovanför morgonrapporten. */
  afternoon?: AfternoonReport | null;
}
const { view, weeks, morning = null, afternoon = null } = Astro.props;
// Swing gäller i dag (uppdateras varje morgon): bara på den senaste veckans sida.
const swing = view.week === weeks[0] && !view.mock ? loadLatestSwing() : null;
const afternoonTime = afternoon
  ? new Date(afternoon.generated_at).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" })
  : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const directionLabel = { positiv: "Positiv", negativ: "Negativ", blandad: "Blandad", oklar: "Oklar" };

const pr = view.policyRate;
// "oförändrad sedan …" om senaste ändringen skedde före veckan, annars "sänkt/höjd från …".
const rateText = pr ? describePolicyRate(pr, view.start, view.end) : null;
// Ett räntebeslut som ännu inte börjat gälla (ur senaste morgonrapporten), bara på den senaste veckans sida.
const latestMorningDate = listMorningDates()[0] ?? null;
const decision = pr && view.week === weeks[0] && latestMorningDate ? (loadMorning(latestMorningDate)?.policy_decision ?? null) : null;
const decisionText = pr ? pendingDecisionText(decision, pr) : null;
const latestMorning = listMorningDates()[0] ?? null;
const morningTime = morning
  ? new Date(morning.generated_at).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" })
  : null;
---

<Base title={`${weekLabel(view.week)} – Veckans finans`}>
  <main>
    {
      view.mock && (
        <div class="mock-banner" role="note">
          <div class="wrap">
            <strong>Exempeldata.</strong> Bolagen, källorna och nyheterna på den här sidan är påhittade och används bara för
            att utveckla sidan.
          </div>
        </div>
      )
    }

    {
      afternoon && (
        <section class="morning-top afternoon-top" aria-labelledby="eftermiddag-rubrik">
          <div class="wrap">
            <p class="brand">
              <a href={`${base}/`}>Veckans finans</a>
            </p>
            <h2 id="eftermiddag-rubrik" class="morning-title">
              Eftermiddag {weekdayDate(afternoon.date).toLowerCase()}
              <span class="morning-time">uppdaterad kl. {afternoonTime}</span>
            </h2>
            <AfternoonReportView report={afternoon} results={loadUpdateResults(afternoon.date)} />
          </div>
        </section>
      )
    }

    {
      morning && (
        <section class="morning-top" aria-labelledby="morgon-rubrik">
          <div class="wrap">
            {!afternoon && (
              <p class="brand">
                <a href={`${base}/`}>Veckans finans</a>
              </p>
            )}
            <h2 id="morgon-rubrik" class="morning-title">
              Morgonrapport {weekdayDate(morning.date).toLowerCase()}
              <span class="morning-time">sammanställd kl. {morningTime}</span>
            </h2>
            <p class="morning-stale" data-morning-date={morning.date} hidden>
              Dagens morgonrapport finns inte ännu, så det här är den senaste. På handelsdagar kommer den kl. 08:10.
            </p>
            <MorningReportView
              report={morning}
              level={3}
              results={loadResults(morning.date)}
              reaction={loadAfternoonBefore(morning.date)}
              after={{ href: "#vecka", label: `${weekLabel(view.week)} ↓` }}
            />
          </div>
        </section>
      )
    }

    <header class="page-head" id="vecka">
      <div class="wrap">
        <p class="brand" hidden={morning !== null}>
          {!morning && <a href={`${base}/`}>Veckans finans</a>}
          {
            latestMorning && !morning && (
              <>
                <span aria-hidden="true"> · </span>
                <a class="morning-link" href={`${base}/morgon/`}>Morgonrapport {shortDate(latestMorning)}</a>
              </>
            )
          }
        </p>
        <div class="title-row">
          <div>
            <h1>{weekLabel(view.week)}</h1>
            <p class="period">{formatDate(view.start)} – {formatDate(view.end)}</p>
            {view.index && (
              <p class="period index-line">
                {view.index.name}:{" "}
                {new Intl.NumberFormat("sv-SE", { minimumFractionDigits: 2, maximumFractionDigits: 2, signDisplay: "exceptZero" }).format(view.index.change_pct)} % under veckan
              </p>
            )}
          </div>
          {
            weeks.length > 1 && (
              <nav class="week-nav" aria-label="Välj vecka">
                <label for="week-select">Vecka</label>
                <select id="week-select" data-week-select>
                  {weeks.map((w) => (
                    <option value={`${base}/vecka/${w}/`} selected={w === view.week}>
                      {weekLabel(w)}
                    </option>
                  ))}
                </select>
              </nav>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap">
      {
        pr && (
          <aside class="key-figures" aria-label="Nyckeltal">
            <div class="kf">
              <p class="kf-label">Riksbankens styrränta</p>
              <p class="kf-value">
                {formatRate(pr.value)} %
                {decisionText && decision && (
                  <a class="kf-decision" href={decision.url} rel="noopener noreferrer" target="_blank">
                    {decisionText}<span class="sr-only"> (Riksbankens pressmeddelande {decision.decided_on}, öppnas i ny flik)</span>
                  </a>
                )}
              </p>
              <p class="kf-meta">
                <span class="kf-change">{formatRate(pr.value)} %, {rateText}</span>
                <span aria-hidden="true"> · </span>
                avser {formatDate(pr.date)}
                <span aria-hidden="true"> · </span>
                <a href={pr.sourceUrl} rel="noopener noreferrer" target="_blank">
                  Riksbanken<span class="sr-only"> (öppnas i ny flik)</span>
                  <span aria-hidden="true"> ↗</span>
                </a>
              </p>
            </div>
          </aside>
        )
      }

      <div class="tabs" role="tablist" aria-label="Sektorer" data-tabs data-sticky-tabs hidden>
        {
          view.sectors.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.sector.id}`}
              aria-controls={`sektor-${s.sector.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-sector={s.sector.id}
            >
              {s.sector.name}
              <span class="count">{s.items.length}</span>
            </button>
          ))
        }
        {
          view.results && (
            <button
              type="button"
              role="tab"
              id="tab-rapporterade"
              aria-controls="sektor-rapporterade"
              aria-selected="false"
              tabindex={-1}
              data-sector="rapporterade"
            >
              Rapporterade bolag
              <span class="count">{view.results.reports.length}</span>
            </button>
          )
        }
        {
          view.signals && (
            <button
              type="button"
              role="tab"
              id="tab-signaler"
              aria-controls="sektor-signaler"
              aria-selected="false"
              tabindex={-1}
              data-sector="signaler"
            >
              Signaler
              <span class="count">{view.signals.rows.filter((r) => r.signals.length > 0).length}</span>
            </button>
          )
        }
        {
          swing && (
            <button
              type="button"
              role="tab"
              id="tab-swing"
              aria-controls="sektor-swing"
              aria-selected="false"
              tabindex={-1}
              data-sector="swing"
            >
              Swing
              <span class="count">{swing.rows.filter((r) => r.labels.some((l) => !l.startsWith("trend"))).length}</span>
            </button>
          )
        }
        {
          view.valuation && (
            <button
              type="button"
              role="tab"
              id="tab-kurs-mot-vinst"
              aria-controls="sektor-kurs-mot-vinst"
              aria-selected="false"
              tabindex={-1}
              data-sector="kurs-mot-vinst"
            >
              Kurs mot vinst
            </button>
          )
        }
        {
          view.calendar && (
            <button
              type="button"
              role="tab"
              id="tab-kommande-vecka"
              aria-controls="sektor-kommande-vecka"
              aria-selected="false"
              tabindex={-1}
              data-sector="kommande-vecka"
            >
              Kommande vecka
              <span class="count">{view.calendar.events.length}</span>
            </button>
          )
        }
        {
          view.analysis && (
            <button
              type="button"
              role="tab"
              id="tab-blankning-insyn"
              aria-controls="sektor-blankning-insyn"
              aria-selected={view.sectors.length === 0 ? "true" : "false"}
              tabindex={view.sectors.length === 0 ? 0 : -1}
              data-sector="blankning-insyn"
            >
              Blankning & insyn
            </button>
          )
        }
      </div>

      {view.sectors.length === 0 && <p class="empty">Inga nyheter den här veckan.</p>}

      {
        view.sectors.map((s) => (
          <section class="sector" id={`sektor-${s.sector.id}`} role="tabpanel" aria-labelledby={`tab-${s.sector.id}`} tabindex="0">
            <h2>{s.sector.name}</h2>
            <p class="sector-summary">{s.summary}</p>

            {s.items.map((it) => (
              <article class="item" id={it.id}>
                <p class="meta">
                  <time datetime={it.published}>{formatDate(it.published)}</time>
                  <span aria-hidden="true"> · </span>
                  <a href={it.sourceUrl} rel="noopener noreferrer" target="_blank">
                    {it.sourceName}
                    <span class="sr-only"> (öppnas i ny flik)</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </p>
                <h3>{it.headline}</h3>
                <p class="summary">{it.summary}</p>
                {it.sentiment && (
                  <p class="tone">
                    <span class:list={["tone-label", it.sentiment.label]}>Ton: {it.sentiment.label}</span>
                    <span class="tone-why">{it.sentiment.rationale}</span>
                  </p>
                )}

                {it.listed.length > 0 && (
                  <div class="cards">
                    {it.listed.map((c) => (
                      <CompanyCard company={c} hasPrices={view.hasPrices} index={view.index} tone={it.sentiment?.label} />
                    ))}
                  </div>
                )}

                {it.notInList.length > 0 && (
                  <div class="not-in-list">
                    <h4>Ej i bevakningslistan</h4>
                    <ul>
                      {it.notInList.map((c) => (
                        <li>
                          <strong>{c.name}</strong> <span class="impact-text">({c.impact})</span>: {c.rationale}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {it.impacts.length > 0 && (
                  <div class="impacts">
                    <h4>Indirekt sektorpåverkan</h4>
                    <ul>
                      {it.impacts.map((imp) => (
                        <li>
                          <span class:list={["dir", imp.direction]}>{directionLabel[imp.direction]}</span>
                          <span>
                            <strong>{imp.sector.name}</strong>: {imp.rationale}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))}
          </section>
        ))
      }

      {
        view.results && (
          <section class="sector" id="sektor-rapporterade" role="tabpanel" aria-labelledby="tab-rapporterade" tabindex="0">
            <h2>Rapporterade bolag</h2>
            <ResultsPanel results={view.results} />
          </section>
        )
      }

      {
        view.signals && (
          <section class="sector" id="sektor-signaler" role="tabpanel" aria-labelledby="tab-signaler" tabindex="0">
            <h2>Signaler</h2>
            <SignalsPanel signals={view.signals} reported={(view.results?.reports ?? []).map((r) => r.ticker)} />
          </section>
        )
      }

      {
        swing && (
          <section class="sector" id="sektor-swing" role="tabpanel" aria-labelledby="tab-swing" tabindex="0">
            <h2>Swing</h2>
            <SwingPanel swing={swing} />
          </section>
        )
      }

      {
        view.valuation && (
          <section class="sector" id="sektor-kurs-mot-vinst" role="tabpanel" aria-labelledby="tab-kurs-mot-vinst" tabindex="0">
            <h2>Kurs mot vinst</h2>
            <ValuationPanel valuation={view.valuation} />
          </section>
        )
      }

      {
        view.calendar && (
          <section class="sector" id="sektor-kommande-vecka" role="tabpanel" aria-labelledby="tab-kommande-vecka" tabindex="0">
            <h2>Kommande vecka</h2>
            <CalendarPanel calendar={view.calendar} />
          </section>
        )
      }

      {
        view.analysis && (
          <section class="sector" id="sektor-blankning-insyn" role="tabpanel" aria-labelledby="tab-blankning-insyn" tabindex="0">
            <h2>Blankning & insyn</h2>
            <AnalysisPanel analysis={view.analysis} />
          </section>
        )
      }
    </div>
  </main>
</Base>

<script>
  // Flikar: visa en sektor åt gången, synka med #sektor-<id> i adressfältet.
  const tablist = document.querySelector<HTMLElement>("[data-tabs]");
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!);

    const select = (index: number, focus = false, updateHash = true) => {
      tabs.forEach((t, i) => {
        const active = i === index;
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      if (focus) tabs[index].focus();
      // Scrolla bara flikraden i sidled (mobil), aldrig hela sidan.
      const t = tabs[index];
      if (t.offsetLeft < tablist.scrollLeft || t.offsetLeft + t.offsetWidth > tablist.scrollLeft + tablist.clientWidth) {
        tablist.scrollTo({ left: t.offsetLeft - 16, behavior: "smooth" });
      }
      if (updateHash) history.replaceState(null, "", `#sektor-${tabs[index].dataset.sector}`);
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => select(i)));
    tablist.addEventListener("keydown", (e) => {
      const current = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
      const keys: Record<string, number> = {
        ArrowRight: (current + 1) % tabs.length,
        ArrowLeft: (current - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      if (e.key in keys) {
        e.preventDefault();
        select(keys[e.key], true);
      }
    });

    // Sektorn i adressfältet, eller sektorn som innehåller en länkad nyhet.
    const fromHash = () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      const panel = target?.closest<HTMLElement>('[role="tabpanel"]');
      return { target, index: panel ? Math.max(0, panels.indexOf(panel)) : 0, isPanel: target === panel };
    };

    const start = fromHash();
    tablist.hidden = false;
    document.documentElement.classList.add("has-tabs");
    select(start.index, false, false);
    if (start.target && !start.isPanel) start.target.scrollIntoView();

    window.addEventListener("hashchange", () => {
      const h = fromHash();
      select(h.index, false, false);
      if (h.target && !h.isPanel) h.target.scrollIntoView();
    });
  }

  // Startsidan: säg till om morgonrapporten inte är dagens (helg, börsstängt eller före 08:10).
  const stale = document.querySelector<HTMLElement>("[data-morning-date]");
  if (stale) {
    const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Stockholm" }).format(new Date());
    stale.hidden = stale.dataset.morningDate === today;
  }

  document.querySelector<HTMLSelectElement>("[data-week-select]")?.addEventListener("change", (e) => {
    location.href = (e.target as HTMLSelectElement).value;
  });
</script>

<style>
  .mock-banner {
    background: var(--banner-bg);
    color: var(--banner-fg);
    border-bottom: 1px solid var(--banner-border);
    padding: 10px 0;
    font-size: 0.9375rem;
  }

  .page-head {
    padding: 24px 0 16px;
    scroll-margin-top: 0;
  }
  .morning-top {
    padding: 24px 0 8px;
    border-bottom: 2px solid var(--border);
  }
  .morning-title {
    margin: 0;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    line-height: 1.2;
  }
  .morning-time {
    display: block;
    margin-top: 2px;
    font-size: 0.9375rem;
    font-weight: normal;
    color: var(--muted);
  }
  .morning-stale {
    margin: 8px 0 4px;
    padding: 8px 12px;
    border-radius: var(--radius);
    background: var(--banner-bg);
    color: var(--banner-fg);
    border: 1px solid var(--banner-border);
    font-size: 0.9375rem;
  }
  .morning-stale[hidden] {
    display: none;
  }
  .brand {
    margin: 0 0 4px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .brand a {
    color: var(--muted);
    text-decoration: none;
  }
  .brand .morning-link {
    color: var(--accent);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    line-height: 1.15;
  }
  .period {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .week-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .week-nav select {
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 8px;
  }

  .key-figures {
    margin: 0 0 16px;
  }
  .kf {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 16px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "label value" "meta meta";
    align-items: baseline;
    column-gap: 16px;
    row-gap: 2px;
  }
  .kf-label {
    grid-area: label;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kf-decision {
    margin-left: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--banner-fg);
    white-space: nowrap;
  }
  .kf-value {
    grid-area: value;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    justify-self: end;
  }
  .kf-meta {
    grid-area: meta;
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: thin;
    padding: 4px 0 10px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 1;
  }
  .tabs[hidden] {
    display: none;
  }
  .tabs button {
    flex-shrink: 0;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tabs button[aria-selected="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .count {
    font-size: 0.75rem;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }

  .sector {
    padding: 16px 0 8px;
  }
  .sector:focus-visible {
    outline-offset: 4px;
  }
  .sector h2 {
    margin: 0 0 6px;
    font-size: 1.375rem;
  }
  /* Med flikar syns sektornamnet redan i flikraden. */
  :global(.has-tabs) .sector h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .sector-summary {
    margin: 0 0 20px;
    font-size: 1.0625rem;
    max-width: 70ch;
  }

  .item {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
  }
  .meta {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .item h3 {
    margin: 4px 0 6px;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .summary {
    margin: 0 0 12px;
    max-width: 70ch;
  }

  .tone {
    margin: -4px 0 12px;
    font-size: 0.875rem;
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .tone-label {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 4px;
    border: 1px solid currentColor;
    color: var(--muted);
  }
  .tone-label.positiv {
    color: var(--pos);
  }
  .tone-label.negativ {
    color: var(--neg);
  }
