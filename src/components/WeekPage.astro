---
/**
 * En veckas sida: rubrik, veckoväljare, mock-banderoll och en flik per sektor.
 * Utan JavaScript visas alla sektorer under varandra; med JavaScript blir de flikar.
 */
import Base from "../layouts/Base.astro";
import AnalysisPanel from "./AnalysisPanel.astro";
import CalendarPanel from "./CalendarPanel.astro";
import SignalsPanel from "./SignalsPanel.astro";
import SwingPanel from "./SwingPanel.astro";
import SwingEvalPanel from "./SwingEvalPanel.astro";
import RotationPanel from "./RotationPanel.astro";
import HbSummaryView from "./HbSummary.astro";
import type { HbSummary as HbSummaryData } from "../lib/hb";
import ResultsPanel from "./ResultsPanel.astro";
import ValuationPanel from "./ValuationPanel.astro";
import CompanyCard from "./CompanyCard.astro";
import MorningReportView from "./MorningReport.astro";
import { weekdayDate } from "../lib/calendar";
import AfternoonReportView from "./AfternoonReport.astro";
import {
  formatDate,
  listMorningDates,
  loadAfternoonBefore,
  loadMorning,
  loadLatestSwing,
  loadSwingEval,
  loadLatestRotation,
  loadResults,
  loadUpdateResults,
  weekLabel,
  type AfternoonReport,
  type MorningReport,
  type WeekView,
} from "../lib/data";
import { shortDate } from "../lib/format";
import { describePolicyRate, formatRate, pendingDecisionText } from "../lib/policyRate";

interface Props {
  view: WeekView;
  weeks: string[];
  /** Startsidan: senaste morgonrapporten visas överst, före veckan och flikarna. */
  morning?: MorningReport | null;
  /** Startsidan: eftermiddagsuppdateringen, ovanför morgonrapporten. */
  afternoon?: AfternoonReport | null;
  /** Startsidan: Handelsbanken-sammanfattningar (manuellt tillagda), överst. */
  hb?: HbSummaryData[];
}
const { view, weeks, morning = null, afternoon = null, hb = [] } = Astro.props;
// Swing gäller i dag (uppdateras varje morgon): bara på den senaste veckans sida.
const swing = view.week === weeks[0] && !view.mock ? loadLatestSwing() : null;
// Den dagliga utvärderingen överst i Swing (data/raw/swing_eval/, scripts/swing_eval.py).
const swingEval = swing ? loadSwingEval() : null;
// Vyn Rotationer (data/rotation/, scripts/rotation.py), bara för senaste veckan.
const rotation = view.week === weeks[0] && !view.mock ? loadLatestRotation() : null;
const afternoonTime = afternoon
  ? new Date(afternoon.generated_at).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" })
  : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const directionLabel = { positiv: "Positiv", negativ: "Negativ", blandad: "Blandad", oklar: "Oklar" };

const pr = view.policyRate;
// "oförändrad sedan …" om senaste ändringen skedde före veckan, annars "sänkt/höjd från …".
const rateText = pr ? describePolicyRate(pr, view.start, view.end) : null;
// Ett räntebeslut som ännu inte börjat gälla (ur senaste morgonrapporten), bara på den senaste veckans sida.
const latestMorningDate = listMorningDates()[0] ?? null;
const decision = pr && view.week === weeks[0] && latestMorningDate ? (loadMorning(latestMorningDate)?.policy_decision ?? null) : null;
const decisionText = pr ? pendingDecisionText(decision, pr) : null;
const latestMorning = listMorningDates()[0] ?? null;
const morningTime = morning
  ? new Date(morning.generated_at).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" })
  : null;
---

<Base title={`${weekLabel(view.week)} – Veckans finans`}>
  <main>
    {
      view.mock && (
        <div class="mock-banner" role="note">
          <div class="wrap">
            <strong>Exempeldata.</strong> Bolagen, källorna och nyheterna på den här sidan är påhittade och används bara för
            att utveckla sidan.
          </div>
        </div>
      )
    }

    {
      hb.length > 0 && (
        <section class="morning-top" aria-labelledby="hb-rubrik">
          <div class="wrap">
            <p class="brand">
              <a href={`${base}/`}>Veckans finans</a>
            </p>
            <h2 id="hb-rubrik" class="morning-title">
              Handelsbanken
              <span class="morning-time">sammanfattat med egna ord, manuellt tillagt</span>
            </h2>
            {hb.map((s) => <HbSummaryView s={s} />)}
          </div>
        </section>
      )
    }

    {
      afternoon && (
        <section class="morning-top afternoon-top" aria-labelledby="eftermiddag-rubrik">
          <div class="wrap">
            {hb.length === 0 && (
              <p class="brand">
                <a href={`${base}/`}>Veckans finans</a>
              </p>
            )}
            <h2 id="eftermiddag-rubrik" class="morning-title">
              Eftermiddag {weekdayDate(afternoon.date).toLowerCase()}
              <span class="morning-time">uppdaterad kl. {afternoonTime}</span>
            </h2>
            <AfternoonReportView report={afternoon} results={loadUpdateResults(afternoon.date)} />
          </div>
        </section>
      )
    }

    {
      morning && (
        <section class="morning-top" aria-labelledby="morgon-rubrik">
          <div class="wrap">
            {!afternoon && hb.length === 0 && (
              <p class="brand">
                <a href={`${base}/`}>Veckans finans</a>
              </p>
            )}
            <h2 id="morgon-rubrik" class="morning-title">
              Morgonrapport {weekdayDate(morning.date).toLowerCase()}
              <span class="morning-time">sammanställd kl. {morningTime}</span>
            </h2>
            <p class="morning-stale" data-morning-date={morning.date} hidden>
              Dagens morgonrapport finns inte ännu, så det här är den senaste. På handelsdagar kommer den kl. 08:10.
            </p>
            <MorningReportView
              report={morning}
              level={3}
              results={loadResults(morning.date)}
              reaction={loadAfternoonBefore(morning.date)}
              after={{ href: "#vecka", label: `${weekLabel(view.week)} ↓` }}
            />
          </div>
        </section>
      )
    }

    <header class="page-head" id="vecka">
      <div class="wrap">
        <p class="brand" hidden={morning !== null}>
          {!morning && <a href={`${base}/`}>Veckans finans</a>}
          {
            latestMorning && !morning && (
              <>
                <span aria-hidden="true"> · </span>
                <a class="morning-link" href={`${base}/morgon/`}>Morgonrapport {shortDate(latestMorning)}</a>
              </>
            )
          }
        </p>
        <div class="title-row">
          <div>
            <h1>{weekLabel(view.week)}</h1>
            <p class="period">{formatDate(view.start)} – {formatDate(view.end)}</p>
            {view.index && (
              <p class="period index-line">
                {view.index.name}:{" "}
                {new Intl.NumberFormat("sv-SE", { minimumFractionDigits: 2, maximumFractionDigits: 2, signDisplay: "exceptZero" }).format(view.index.change_pct)} % under veckan
              </p>
            )}
          </div>
          {
            weeks.length > 1 && (
              <nav class="week-nav" aria-label="Välj vecka">
                <label for="week-select">Vecka</label>
                <select id="week-select" data-week-select>
                  {weeks.map((w) => (
                    <option value={`${base}/vecka/${w}/`} selected={w === view.week}>
                      {weekLabel(w)}
                    </option>
                  ))}
                </select>
              </nav>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap">
      {
        pr && (
          <aside class="key-figures" aria-label="Nyckeltal">
            <div class="kf">
              <p class="kf-label">Riksbankens styrränta</p>
              <p class="kf-value">
                {formatRate(pr.value)} %
                {decisionText && decision && (
                  <a class="kf-decision" href={decision.url} rel="noopener noreferrer" target="_blank">
                    {decisionText}<span class="sr-only"> (Riksbankens pressmeddelande {decision.decided_on}, öppnas i ny flik)</span>
                  </a>
                )}
              </p>
              <p class="kf-meta">
                <span class="kf-change">{formatRate(pr.value)} %, {rateText}</span>
                <span aria-hidden="true"> · </span>
                avser {formatDate(pr.date)}
                <span aria-hidden="true"> · </span>
                <a href={pr.sourceUrl} rel="noopener noreferrer" target="_blank">
                  Riksbanken<span class="sr-only"> (öppnas i ny flik)</span>
                  <span aria-hidden="true"> ↗</span>
                </a>
              </p>
            </div>
          </aside>
        )
      }

      <div class="views" data-views hidden>
        <label class="view-label">
          Vy
          <select data-view-select>
            {rotation && <option value="rotationer">Rotationer</option>}
            {swing && <option value="swing">Swing</option>}
            {view.signals && (
              <option value="signaler">Signaler ({view.signals.rows.filter((r) => r.signals.length > 0).length})</option>
            )}
            {view.results && <option value="rapporterade">Rapporter ({view.results.reports.length})</option>}
            {view.sectors.length > 0 && (
              <optgroup label="Nyheter per sektor">
                {view.sectors.map((s) => (
                  <option value={s.sector.id}>{s.sector.name} ({s.items.length})</option>
                ))}
              </optgroup>
            )}
            {(view.valuation || view.calendar || view.analysis) && (
              <optgroup label="Mer">
                {view.valuation && <option value="kurs-mot-vinst">Kurs mot vinst</option>}
                {view.calendar && <option value="kommande-vecka">Kommande vecka ({view.calendar.events.length})</option>}
                {view.analysis && <option value="insyn">Insyn</option>}
              </optgroup>
            )}
          </select>
        </label>
        <span class="view-hint">Bara vald vy visas; tabellerna visar högst 10 rader.</span>
      </div>

      {
        rotation && (
          <section class="sector" id="sektor-rotationer" data-view-panel tabindex="0">
            <h2>Rotationer</h2>
            <RotationPanel rotation={rotation} />
          </section>
        )
      }

      {view.sectors.length === 0 && <p class="empty">Inga nyheter den här veckan.</p>}

      {
        view.sectors.map((s) => (
          <section class="sector" id={`sektor-${s.sector.id}`} data-view-panel tabindex="0">
            <h2>{s.sector.name}</h2>
            <p class="sector-summary">{s.summary}</p>

            {s.items.map((it) => (
              <article class="item" id={it.id}>
                <p class="meta">
                  <time datetime={it.published}>{formatDate(it.published)}</time>
                  <span aria-hidden="true"> · </span>
                  <a href={it.sourceUrl} rel="noopener noreferrer" target="_blank">
                    {it.sourceName}
                    <span class="sr-only"> (öppnas i ny flik)</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </p>
                <h3>{it.headline}</h3>
                <p class="summary">{it.summary}</p>
                {it.sentiment && (
                  <p class="tone">
                    <span class:list={["tone-label", it.sentiment.label]}>Ton: {it.sentiment.label}</span>
                    <span class="tone-why">{it.sentiment.rationale}</span>
                  </p>
                )}

                {it.listed.length > 0 && (
                  <div class="cards">
                    {it.listed.map((c) => (
                      <CompanyCard company={c} hasPrices={view.hasPrices} index={view.index} tone={it.sentiment?.label} />
                    ))}
                  </div>
                )}

                {it.notInList.length > 0 && (
                  <div class="not-in-list">
                    <h4>Ej i bevakningslistan</h4>
                    <ul>
                      {it.notInList.map((c) => (
                        <li>
                          <strong>{c.name}</strong> <span class="impact-text">({c.impact})</span>: {c.rationale}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {it.impacts.length > 0 && (
                  <div class="impacts">
                    <h4>Indirekt sektorpåverkan</h4>
                    <ul>
                      {it.impacts.map((imp) => (
                        <li>
                          <span class:list={["dir", imp.direction]}>{directionLabel[imp.direction]}</span>
                          <span>
                            <strong>{imp.sector.name}</strong>: {imp.rationale}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))}
          </section>
        ))
      }

      {
        view.results && (
          <section class="sector" id="sektor-rapporterade" data-view-panel tabindex="0">
            <h2>Rapporterade bolag</h2>
            <ResultsPanel results={view.results} />
          </section>
        )
      }

      {
        view.signals && (
          <section class="sector" id="sektor-signaler" data-view-panel tabindex="0">
            <h2>Signaler</h2>
            <SignalsPanel signals={view.signals} reported={(view.results?.reports ?? []).map((r) => r.ticker)} />
          </section>
        )
      }

      {
        swing && (
          <section class="sector" id="sektor-swing" data-view-panel tabindex="0">
            <h2>Swing</h2>
            {
              swingEval && (
                <details class="fold">
                  <summary>Utvärdering: marknadsläge, larm, gårdagens rörelser, mönster och lyckade fall</summary>
                  <SwingEvalPanel ev={swingEval} />
                </details>
              )
            }
            <SwingPanel swing={swing} ev={swingEval} />
          </section>
        )
      }

      {
        view.valuation && (
          <section class="sector" id="sektor-kurs-mot-vinst" data-view-panel tabindex="0">
            <h2>Kurs mot vinst</h2>
            <ValuationPanel valuation={view.valuation} />
          </section>
        )
      }

      {
        view.calendar && (
          <section class="sector" id="sektor-kommande-vecka" data-view-panel tabindex="0">
            <h2>Kommande vecka</h2>
            <CalendarPanel calendar={view.calendar} />
          </section>
        )
      }

      {
        view.analysis && (
          <section class="sector" id="sektor-insyn" data-view-panel tabindex="0">
            <h2>Insyn</h2>
            <AnalysisPanel analysis={view.analysis} />
          </section>
        )
      }
    </div>
  </main>
</Base>

<script>
  // Vyer: rullistan "Vy" visar en sektion åt gången och synkar med #sektor-<id> i adressfältet; senast valda vy
  // sparas i webbläsaren. Utan JavaScript visas alla sektioner.
  const viewSelect = document.querySelector<HTMLSelectElement>("[data-view-select]");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("section[data-view-panel]"));
  if (viewSelect && panels.length > 0) {
    const ids = Array.from(viewSelect.options).map((o) => o.value);
    const show = (id: string, updateHash = true) => {
      panels.forEach((p) => (p.hidden = p.id !== `sektor-${id}`));
      viewSelect.value = id;
      if (updateHash) history.replaceState(null, "", `#sektor-${id}`);
      try {
        localStorage.setItem("vf-vy", id);
      } catch {
        /* utan lagring: inget att spara */
      }
    };
    // Vyn i adressfältet, eller vyn som innehåller en länkad nyhet.
    const fromHash = () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      const panel = target?.closest<HTMLElement>("section[data-view-panel]");
      const id = panel ? panel.id.replace(/^sektor-/, "") : null;
      return { target, id: id && ids.includes(id) ? id : null, isPanel: target === panel };
    };
    let saved: string | null = null;
    try {
      saved = localStorage.getItem("vf-vy");
    } catch {
      saved = null;
    }
    const start = fromHash();
    document.querySelector<HTMLElement>("[data-views]")!.hidden = false;
    document.documentElement.classList.add("has-tabs");
    show(start.id ?? (saved && ids.includes(saved) ? saved : ids[0]), false);
    if (start.target && !start.isPanel) start.target.scrollIntoView();
    viewSelect.addEventListener("change", () => show(viewSelect.value));
    window.addEventListener("hashchange", () => {
      const h = fromHash();
      if (!h.id) return;
      show(h.id, false);
      if (h.target && !h.isPanel) h.target.scrollIntoView();
    });
  }

  // Högst 10 rader i varje tabell i vyerna, med "Visa alla" (räknar bara rader som filtren inte dolt; sortering och
  // filter i tabellerna fungerar som förut).
  const LIMIT = 10;
  for (const table of document.querySelectorAll<HTMLTableElement>("section[data-view-panel] table")) {
    const body = table.tBodies[0];
    if (!body || body.rows.length <= LIMIT) continue;
    table.dataset.limit = String(LIMIT);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "show-all";
    const wrap = table.closest(".table-outer, .hist-wrap, .table-wrap") ?? table;
    wrap.after(btn);
    const update = () => {
      const visible = Array.from(body.rows).filter((r) => !r.hidden).length;
      const all = table.hasAttribute("data-show-all");
      btn.hidden = visible <= LIMIT;
      btn.textContent = all ? `Visa ${LIMIT} rader` : `Visa alla (${visible})`;
      btn.setAttribute("aria-expanded", String(all));
    };
    btn.addEventListener("click", () => {
      table.toggleAttribute("data-show-all");
      update();
    });
    new MutationObserver(update).observe(body, { attributes: true, attributeFilter: ["hidden"], subtree: true });
    update();
  }

  // Startsidan: säg till om morgonrapporten inte är dagens (helg, börsstängt eller före 08:10).
  const stale = document.querySelector<HTMLElement>("[data-morning-date]");
  if (stale) {
    const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Stockholm" }).format(new Date());
    stale.hidden = stale.dataset.morningDate === today;
  }

  document.querySelector<HTMLSelectElement>("[data-week-select]")?.addEventListener("change", (e) => {
    location.href = (e.target as HTMLSelectElement).value;
  });
</script>

<style>
  .mock-banner {
    background: var(--banner-bg);
    color: var(--banner-fg);
    border-bottom: 1px solid var(--banner-border);
    padding: 10px 0;
    font-size: 0.9375rem;
  }

  .page-head {
    padding: 24px 0 16px;
    scroll-margin-top: 0;
  }
  .morning-top {
    padding: 24px 0 8px;
    border-bottom: 2px solid var(--border);
  }
  .morning-title {
    margin: 0;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    line-height: 1.2;
  }
  .morning-time {
    display: block;
    margin-top: 2px;
    font-size: 0.9375rem;
    font-weight: normal;
    color: var(--muted);
  }
  .morning-stale {
    margin: 8px 0 4px;
    padding: 8px 12px;
    border-radius: var(--radius);
    background: var(--banner-bg);
    color: var(--banner-fg);
    border: 1px solid var(--banner-border);
    font-size: 0.9375rem;
  }
  .morning-stale[hidden] {
    display: none;
  }
  .brand {
    margin: 0 0 4px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .brand a {
    color: var(--muted);
    text-decoration: none;
  }
  .brand .morning-link {
    color: var(--accent);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    line-height: 1.15;
  }
  .period {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .week-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .week-nav select {
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 8px;
  }

  .key-figures {
    margin: 0 0 16px;
  }
  .kf {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 16px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "label value" "meta meta";
    align-items: baseline;
    column-gap: 16px;
    row-gap: 2px;
  }
  .kf-label {
    grid-area: label;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kf-decision {
    margin-left: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--banner-fg);
    white-space: nowrap;
  }
  .kf-value {
    grid-area: value;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    justify-self: end;
  }
  .kf-meta {
    grid-area: meta;
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: thin;
    padding: 4px 0 10px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 1;
  }
  .tabs[hidden] {
    display: none;
  }
  .tabs button {
    flex-shrink: 0;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tabs button[aria-selected="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .count {
    font-size: 0.75rem;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }

  .sector {
    padding: 16px 0 8px;
  }
  .sector:focus-visible {
    outline-offset: 4px;
  }
  .sector h2 {
    margin: 0 0 6px;
    font-size: 1.375rem;
  }
  /* Med flikar syns sektornamnet redan i flikraden. */
  :global(.has-tabs) .sector h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .sector-summary {
    margin: 0 0 20px;
    font-size: 1.0625rem;
    max-width: 70ch;
  }

  .item {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
  }
  .meta {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .item h3 {
    margin: 4px 0 6px;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .summary {
    margin: 0 0 12px;
    max-width: 70ch;
  }

  .tone {
    margin: -4px 0 12px;
    font-size: 0.875rem;
    display: flex;
    gap: 8px;
