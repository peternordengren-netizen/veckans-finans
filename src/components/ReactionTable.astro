---
/**
 * Kursreaktionen för bolag som rapporterat (scripts/afternoon.py): kurs, dagens förändring, vinst
 * per aktie mot förväntan (samma regler och texter som i rapportutfallen) och mot samma kvartal i
 * fjol, sektorns huvudnyckeltal mot fjol och "I rapporten" (validerad rad ur rapportutfallen). Rader där utfallet var över förväntan men kursen föll, eller under men kursen steg, markeras.
 * Används i eftermiddagen ("Kursreaktion i dag") och i morgonrapporten ("Kursreaktion i går").
 */
import { weekdayDate } from "../lib/calendar";
import type { AfternoonReport } from "../lib/data";
import { shortDate } from "../lib/format";
import { reactionOutcome, type ReportResult } from "../lib/results";
import { signedPct } from "../lib/signals";

interface Props {
  report: AfternoonReport;
  outcomes: Map<string, ReportResult>;
  /** "today": eftermiddagen, "previous": morgonrapportens förra handelsdag. */
  mode: "today" | "previous";
  headingId: string;
  /** Rubriknivå: 3 i eftermiddagen, 2 eller 3 i morgonrapporten. */
  level?: 2 | 3;
}
const { report, outcomes, mode, headingId, level = 3 } = Astro.props;
const H = level === 2 ? "h2" : "h3";
const time = (iso: string) =>
  new Date(iso).toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" });
const localDay = (iso: string) => new Date(iso).toLocaleDateString("sv-SE", { timeZone: "Europe/Stockholm" });
const dayTime = (iso: string) => (localDay(iso) === report.date ? time(iso) : `${shortDate(localDay(iso))} ${time(iso)}`);
const price = (v: number | null) =>
  v === null ? "–" : v.toLocaleString("sv-SE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
// Före stängning bara om filen togs fram samma dag som kurserna gäller och före 17:30.
const beforeClose = localDay(report.generated_at) === report.date && time(report.generated_at) < "17:30";
const reacted = report.companies
  .filter((c) => !c.after_close)
  .map((c) => ({
    ...c,
    outcome: reactionOutcome(c.change_pct, outcomes.get(c.ticker)),
    // Analytikerlänkar ur instruments.csv (kontrollerade adresser); saknas i äldre filer.
    links: c.links ?? { placera: null, affarsvarlden: null },
  }));
const afterClose = report.companies.filter((c) => c.after_close);
const divergent = reacted.filter((c) => c.outcome.divergent).length;
const weak = reacted.filter((c) => c.outcome.weak.length > 0).length;
const tone = (v: number | null) => (v === null ? "" : v > 0 ? "pos" : v < 0 ? "neg" : "");
const title = mode === "today" ? "Kursreaktion i dag" : `Kursreaktion ${weekdayDate(report.date).toLowerCase()}`;
const dayCol = mode === "today" ? "I dag" : "Dagen";
---

<section class="reaction" aria-labelledby={headingId}>
  <H id={headingId}>{title}</H>
  <p class="note">
    Bolag som rapporterat sedan förra handelsdagens stängning: kursen {beforeClose ? `kl. ${time(report.generated_at)}` : "vid stängning"}{" "}
    mot förra handelsdagens stängning, vinst per aktie och omsättning mot förväntan, vinst per aktie mot samma kvartal i fjol (för
    fastighetsbolag förvaltningsresultat per aktie när rapporten anger det; perioden syns när du håller över värdet),
    sektorns viktigaste nyckeltal mot fjol och tonen i det rapporten själv lyfter fram.
    {report.index.change_pct !== null && ` ${report.index.name}: ${signedPct(report.index.change_pct, 2)}.`}
    {report.price_day === null && reacted.length > 0 && " Yahoo har inga kurser för dagen ännu."}
    {divergent > 0 && <> <span class="flag" aria-hidden="true">⚑</span> = kursen gick mot utfallet ({divergent}).</>}
    {weak > 0 && <> <span class="weak" aria-hidden="true">▼</span> = svag punkt: vinst eller omsättning mer än 5 % under förväntan, nyckeltalet sämre än fjol eller negativ ton ({weak}).</>}
  </p>
  <p class="note">
    Förväntan är Yahoos konsensus (snittet av analytikerna hos Yahoo, sparat före rapporten). Den kan skilja sig från
    den konsensus marknaden jämför med, t.ex. Modular Finance, Bloomberg eller FactSet, som ofta gäller rörelseresultatet.
  </p>
  {report.companies.length === 0 && <p class="empty">Inga rapporter från bolag i bevakningslistan sedan förra handelsdagens stängning.</p>}
  {
    reacted.length > 0 && (
      <details class="table-fold">
      <summary>Visa tabellen ({reacted.length} bolag)</summary>
      <div class="table-outer" data-table-outer>
      <div class="table-wrap" data-table-wrap>
        <table>
          <thead>
            <tr>
              <th scope="col">Bolag</th>
              <th scope="col">Rapport</th>
              <th scope="col" class="num">Kurs</th>
              <th scope="col" class="num">{dayCol}</th>
              <th scope="col">Vinst/aktie mot förväntan</th>
              <th scope="col">Omsättning mot förväntan</th>
              <th scope="col" class="num">Mot fjol</th>
              <th scope="col">Nyckeltal mot fjol</th>
              <th scope="col">Ton i rapporten</th>
              <th scope="col">Analytiker</th>
            </tr>
          </thead>
          <tbody>
            {reacted.map((c) => (
              <tr class:list={{ divergent: c.outcome.divergent }}>
                <th scope="row">
                  {c.outcome.divergent && (
                    <span class="flag" title="Kursen gick mot utfallet">
                      ⚑<span class="sr-only"> Kursen gick mot utfallet: </span>
                    </span>
                  )}
                  {c.outcome.weak.length > 0 && (
                    <span class="weak" title={`Svag punkt: ${c.outcome.weak.join("; ")}`}>
                      ▼<span class="sr-only"> Svag punkt: {c.outcome.weak.join("; ")}: </span>
                    </span>
                  )}
                  <strong>{c.name}</strong> <span class="muted">{c.ticker}</span>
                </th>
                <td>
                  <a href={c.url} rel="noopener noreferrer" target="_blank">
                    {dayTime(c.published)}
                    <span class="sr-only"> – {c.title} (öppnas i ny flik)</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </td>
                <td class="num">{price(c.close)}</td>
                <td class:list={["num", tone(c.change_pct)]}>{signedPct(c.change_pct)}</td>
                <td class="wrap" title={c.outcome.vsExpected?.title}>
                  {c.outcome.vsExpected ? (
                    <span class:list={["verdict", c.outcome.vsExpected.verdict.replace(" ", "-")]}>
                      {c.outcome.vsExpected.text}
                      {c.outcome.vsExpected.basis === "justerat" && <span class="basis"> (just.)</span>}
                      <span class="source">{c.outcome.vsExpected.source}</span>
                    </span>
                  ) : (
                    <span class="muted">–</span>
                  )}
                </td>
                <td class="wrap" title={c.outcome.revenueVsExpected?.title}>
                  {c.outcome.revenueVsExpected ? (
                    <span class:list={["verdict", c.outcome.revenueVsExpected.verdict.replace(" ", "-")]}>
                      {c.outcome.revenueVsExpected.text}
                      <span class="source">{c.outcome.revenueVsExpected.source}</span>
                    </span>
                  ) : (
                    <span class="muted">–</span>
                  )}
                </td>
                <td class="num wrap" title={c.outcome.vsLastYearTitle ?? undefined}>
                  {c.outcome.vsLastYear}
                  {c.outcome.vsLastYearTitle && <span class="sr-only"> ({c.outcome.vsLastYearTitle})</span>}
                </td>
                <td class="wrap" title={c.outcome.sectorKpi?.title}>
                  {c.outcome.sectorKpi ? (
                    <>
                      <span class="kpi-name">{c.outcome.sectorKpi.name}</span>{" "}
                      <span class="kpi-value">{c.outcome.sectorKpi.text}</span>
                      <span class="sr-only"> ({c.outcome.sectorKpi.title})</span>
                    </>
                  ) : (
                    <span class="muted">–</span>
                  )}
                </td>
                <td class="highlight">
                  {c.outcome.tone && <span class:list={["tone", c.outcome.tone]}>{c.outcome.tone}</span>}{" "}
                  {c.outcome.highlight ?? <span class="muted">–</span>}
                </td>
                <td class="links">
                  {c.links.placera || c.links.affarsvarlden ? (
                    <>
                      {c.links.placera && (
                        <a href={c.links.placera} rel="noopener noreferrer" target="_blank">
                          Placera<span class="sr-only"> om {c.name} (öppnas i ny flik)</span>
                        </a>
                      )}
                      {c.links.placera && c.links.affarsvarlden && " · "}
                      {c.links.affarsvarlden && (
                        <a href={c.links.affarsvarlden} rel="noopener noreferrer" target="_blank">
                          Affärsvärlden<span class="sr-only"> om {c.name} (öppnas i ny flik)</span>
                        </a>
                      )}
                    </>
                  ) : (
                    <span class="muted">–</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </div>
      </details>
    )
  }
  {
    afterClose.length > 0 && (
      <p class="note after">
        Efter stängning, reaktionen syns nästa handelsdag:{" "}
        {afterClose.map((c, i) => (
          <>
            {i > 0 && ", "}
            <a href={c.url} rel="noopener noreferrer" target="_blank">
              {c.name} {time(c.published)}
            </a>
          </>
        ))}
        .
      </p>
    )
  }
</section>

<script>
  import { setupFullWidth, setupStickyHeader } from "../lib/tableClient";

  // Full fönsterbredd, kantskugga och fast rubrikrad, som signaltabellen. Tabellen finns både i eftermiddagen
  // och i morgonrapporten.
  document.querySelectorAll<HTMLElement>(".reaction").forEach((root) => {
    setupFullWidth(root);
    setupStickyHeader(root);
  });
</script>

<style>
  .reaction {
    padding: 12px 0 8px;
    scroll-margin-top: 8px;
  }
  .reaction > :is(h2, h3) {
    margin: 0 0 6px;
    font-size: 1.1875rem;
  }
  .note,
  .empty,
  .muted {
    color: var(--muted);
  }
  .note {
    margin: 0 0 10px;
    font-size: 0.875rem;
    max-width: 70ch;
  }
  .note.after {
    margin-top: 10px;
  }
  .empty {
    margin: 0 0 8px;
  }
  /* Tabellen bryter ut ur textspalten och använder fönstrets bredd (16 px marginal per sida), som
     signaltabellen. --sbw = rullningslistens bredd, sätts av tableClient.setupFullWidth. */
  .table-outer {
    --full: calc(100vw - var(--sbw, 0px) - 32px);
    position: relative;
    isolation: isolate;
    width: var(--full);
    margin-left: calc((100% - var(--full)) / 2);
  }
  /* Skugga vid högerkanten när tabellen ändå är bredare än fönstret och går att rulla. */
  .table-outer::after {
    content: "";
    position: absolute;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: 32px;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: linear-gradient(to left, var(--scroll-shadow), transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    z-index: 3;
  }
  .table-outer.more-right::after {
    opacity: 1;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  /* Mot förväntan och Mot fjol får radbrytas ("kontrollera: 0,166 EUR (förv. 0,074)"). */
  td.wrap {
    white-space: normal;
    min-width: 9ch;
    max-width: 18ch;
  }
  /* Rubrikerna radbryts, så att de långa ("Vinst/aktie mot förväntan") inte bestämmer kolumnbredden. */
  thead th {
    white-space: normal;
    vertical-align: bottom;
    min-width: 7ch;
  }
  /* "I rapporten": högst 15 ord, radbryts. */
  td.highlight {
    white-space: normal;
    min-width: 22ch;
    max-width: 34ch;
  }
  .kpi-name {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .kpi-value {
    white-space: nowrap;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 6px 10px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  thead th {
    background: var(--surface-2);
  }
  tbody th {
    font-weight: normal;
  }
  th.num,
  td.num {
    text-align: right;
  }
  tr.divergent {
    background: var(--banner-bg);
  }
  .flag {
    color: var(--banner-fg);
    font-weight: 700;
    margin-right: 4px;
  }
  .pos {
    color: var(--pos);
  }
  .neg {
    color: var(--neg);
  }
  .verdict {
    font-size: 0.8125rem;
  }
  .verdict.över {
    color: var(--pos);
  }
  .verdict.under {
    color: var(--neg);
  }
  .verdict.kontrollera {
    color: var(--banner-fg);
  }
  .basis {
    color: var(--muted);
  }
  /* Källan och antalet analytiker under procenten. */
  .source {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .weak {
    color: var(--neg);
    font-weight: 700;
    margin-right: 4px;
  }
  .tone {
    display: inline-block;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 0.75rem;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .tone.positiv {
    color: var(--pos);
    border-color: currentColor;
  }
  .tone.negativ {
    color: var(--neg);
    border-color: currentColor;
  }
  td.links a {
    white-space: nowrap;
  }
  td.links {
    white-space: normal;
    min-width: 12ch;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* Tabellen ihopfälld under "Visa tabellen" (färre synliga tabeller på startsidan). */
  .table-fold > summary {
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--muted);
    margin: 4px 0 8px;
  }
</style>
